	ton_Watchdog: TON;
	nLastWatchdogFromReportingDB	: DINT;
	bWait: BOOL;
	
	rtStratupComplete 	: r_trig;
	nShiftID			: INT;
	
	nCameraIndex	: INT;
	
END_VAR
]]></Declaration>
    <Implementation>

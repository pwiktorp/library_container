    <Action Name="Camera01" Id="{d9410514-f5a0-4cd7-b192-96147cc84076}">
      <Implementation>
        <ST><![CDATA[(*********************************************************CAMERA 01**********************************************************************)

(*stMasterListCameraOptions		: ST_SCANNER_Options := (eScannerType := E_MV_420_FULL, nImageBuffer := 1, nExpectedResp := 1);*)
IF gProcess.ePackAggregationMode <> E_SYSTEM_PAOL_2CAM AND gProcess.ePackAggregationMode <> E_SYSTEM_PAOL_3CAM  THEN

	gDevice.aCameraLightingIntensity[1] := F_SCANNER_LightingIntensity(gDevice.stMachineConfig.aCameraSettings[1].nLightingIntensity);

	gDevice.aCameraControl[1].stOptions.bUseExternalLight := gDevice.stMachineConfig.aCameraSettings[1].bUseExternalLight;
	gDevice.aCameraControl[1].stOptions.eScannerType	:= gDevice.stMachineConfig.aCameraSettings[1].eScannerType;

	IF gDevice.aCameraControl[1].stOptions.eScannerType = E_SCANNER_DeviceType.V430F THEN

		gDevice.aCameraControl[1].stOptions.nImageBuffer	:= 1;
		gDevice.aCameraControl[1].stOptions.nExpectedResp := 1;
		gDevice.aCameraControl[1].nReqProgram := 1;

	ELSE

		gDevice.aCameraControl[1].stOptions.nImageBuffer 	:= gDevice.stMachineConfig.aCameraSettings[1].nImageBuffer;
		gDevice.aCameraControl[1].stOptions.nExpectedResp := gDevice.stMachineConfig.aCameraSettings[1].nExpectedResp;

		CASE gDevice.stMachineConfig.aCameraSettings[1].eExpectedType OF
				E_SCANNER_CodeType.DATAMARTIX:
					gDevice.aCameraControl[1].nReqProgram := 1;
				E_SCANNER_CodeType.DOTCODE:
					gDevice.aCameraControl[1].nReqProgram := 2;
				E_SCANNER_CodeType.QR:
					gDevice.aCameraControl[1].nReqProgram := 3;
				E_SCANNER_CodeType.CODE128:
					gDevice.aCameraControl[1].nReqProgram := 4;
			ELSE
				gDevice.aCameraControl[1].nReqProgram := 1;
			END_CASE
	END_IF
END_IF]]></ST>
      </Implementation>
    </Action>
    <Action Name="Camera02" Id="{fd089a61-2748-49c3-a78a-a8f7930551e9}">

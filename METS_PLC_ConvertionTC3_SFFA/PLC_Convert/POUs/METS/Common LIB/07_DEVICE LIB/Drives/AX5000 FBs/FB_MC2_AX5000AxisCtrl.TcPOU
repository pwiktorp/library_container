<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_MC2_AX5000AxisCtrl" Id="{a2b20806-817a-404a-b050-32ae9941c146}" SpecialFunc="None">
    <Declaration><![CDATA[(* NC axis ctrl for AX5000 via EtherCAT *)
FUNCTION_BLOCK FB_MC2_AX5000AxisCtrl
VAR_INPUT
	bEnable				: BOOL;		(* set TRUE to enable axis and drive *)
	bReset				: BOOL;		(* set TRUE to reset axis or drive from ERROR condition, min 100ms pulse length *)

	bEnableRevDir			: BOOL;		(* set TRUE to allow axis to run in reverse direction *)
	fOverride				: LREAL;	(* max axis output in % *)
	nEtherCATState		: UINT;		(* EtherCAT operating state *)
	(*bCalibrateAxis			: BOOL;*)
	(*bCalibrateSensorExist	: BOOL;*)

	bFastStop				: BOOL;		(* set TRUE to override RUN signals and stop axis immediately *)
	(*stAxisControl		: ST_AXIS_Control;*)

	eMotionType		: E_AXIS_MotionType;
	(*bRunAxis			: BOOL;	(*execute run*)*)
	fDistance			: LREAL;	(*target relative position*)
	fPosition			: LREAL;	(*target absolute position*)
	fSetVelo			: LREAL;	(* target velocity *)
	bStopAtPos		: BOOL;	(* set TRUE to stop at specified pos, set FALSE to stop immediately *)
	fStopPos			: LREAL;	(* target modulo stop position *)

	bJogFwd			: BOOL;		(* set TRUE to jog forwards *)
	bJogRev			: BOOL;		(* set TRUE to jog reverse *)
	fJogVelo			: LREAL;	(* jog velocity (does not take effect if jog is in progress *)

	(*stRamps				: ST_AxisCtrlRamps;	(* ramps for FastStop, Normal and Jog *)*)

	bSafetyNotOK			: BOOL;
	bCalibrateSyncImpulse	: BOOL;
END_VAR
VAR_IN_OUT
	stAxisConfig			: ST_AXIS_Config;
	stParamSet			: ST_AxisParameterSet;	(* NC axis parameter set *)
	stAxis				: AXIS_REF;	(* NC axis structure *)
END_VAR
VAR_OUTPUT
	bInitOK				: BOOL;		(* TRUE = parameter set read at least once *)
	bEnabled			: BOOL;		(* TRUE = axis is enabled *)
	bActive				: BOOL;		(* TRUE = axis is moving *)
	bHomeActive			: BOOL;
	bVeloActive			: BOOL;
	bAbsActive			: BOOL;
	bRelActive			: BOOL;
	bJogActive			: BOOL;		(* TRUE = axis is moving in JOG mode *)
	bRunningFwd			: BOOL;		(* TRUE = axis is running forwards *)
	bRunningRev			: BOOL;		(* TRUE = axis is running backwards *)
	bCalibrated			: BOOL;		(*TRUE = axis has benn calibrated*)
	(*bHomed				: BOOL;*)		(* TRUE = axis has been homed *)
	bAxisError			: BOOL;		(* TRUE = axis is in error state *)
	nAxisErrorID		: UDINT;	(* NC axis error code *)
	fActPos				: LREAL;	(* axis absolute position *)
	fModuloPos			: LREAL;	(* axis modulo position *)
	fActVelo			: LREAL;	(* axis act ual velocity *)
	bDriveError			: BOOL;		(* TRUE = drive is in error state *)
	nStatusDWord		: DWORD;	(* drive status code *)
	fDCLinkVolts		: LREAL;	(* DC link voltage (volts) *)
	fAmplifierTemp		: LREAL;	(* Amplifier temperature (degrees) *)
END_VAR
VAR
	(*bRunVelo			: BOOL;		(* set TRUE to run axis at specified velocity *)
	bRunAbsolute		: BOOL;		(* set TRUE to run axis at specified position *)
	bRunRelative		: BOOL;		(* set TRUE to run axis at specified distance *)*)

	bTest : BOOL;
	bAxisReset		: BOOL;
	bDriveReset		: BOOL;

	ftrigSaftyReset			: F_TRIG;
	fbAxisCtrl				: FB_MC2_BasicAxisCtrl;
	fbEtherCATDelay		: TON;
	fbAxisHome			: MC_Home;
	fbVeloCtrl				: FB_MC2_VeloCtrl;
	fbAbsCtrl				: FB_MC2_AbsCtrl;
	fbRelCtrl				: FB_MC2_RelCtrl;
	fbDriveReset			: FB_SoEReset;
	fbDriveStatus			: FB_MC2_AX5000Status;
END_VAR
(*
-------------------------------------------------------------------------------------------------
Date		Version	Author	Comments
-------------------------------------------------------------------------------------------------
30/01/2015	3.00.00	PB		Updated with new FB_MC2_BasicAxisCtrl
							FB_SoEReset for DriveReset now phased with fbSyncTimer in FB_MC2_BasicAxisCtrl
							FB_SoERead for strDriveStatus and nDriveStatusCode now phased with fbSyncTimer in FB_MC2_BasicAxisCtrl

-------------------------------------------------------------------------------------------------
18/05/2012	1.09.00	PB		FB_MC_AxisCtrl replaced by FB_MC2_BasicAxisCtrl and FB_MC2_VeloCtrl
17/01/2011	1.06.00	PB		5 cycle delay added between EtherCAT OP mode and bInitOK flag
23/09/2010	1.00.01	PB		Comms status added to bInitOK flag
05/02/2010	1.00.00	PB		Initial release

-------------------------------------------------------------------------------------------------
*)
]]></Declaration>

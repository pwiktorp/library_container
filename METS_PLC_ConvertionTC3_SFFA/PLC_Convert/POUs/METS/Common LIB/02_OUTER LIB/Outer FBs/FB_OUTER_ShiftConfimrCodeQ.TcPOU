<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_OUTER_ShiftConfimrCodeQ" Id="{4519706f-8475-4c7f-87fa-03c5288c75eb}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_OUTER_ShiftConfimrCodeQ
VAR_INPUT
	bClearPackConfirmationQueue	: BOOL;
	stConfirmationBarcode		: ST_SCANNER_ImageData;	(* 2D barcode from scanner *)
	bSensor1				: BOOL;
	bSensor2				: BOOL;
	bSensor3				: BOOL;
	bSensor4				: BOOL;
	stCodeInfo_Pack						: ST_CodeInfo;
END_VAR
VAR_IN_OUT
	stPackConfirmationQueue	: ST_PACK_ConfirmationQueue;
END_VAR
VAR_OUTPUT
	stInterimBarcodeForLabeler	: ST_SCANNER_ImageData;
	stAggregationBarcode		: ST_SCANNER_ImageData;
END_VAR
VAR
	fbExecute1			: R_TRIG;
	fbExecute2			: R_TRIG;
	fbExecute3			: R_TRIG;
	fbExecute4			: R_TRIG;

	bEnableSesnor2		: BOOL;
	bEnableSesnor3		: BOOL;

	nQueueIndex		: INT;
	nMaxQueueIndex	: INT;

	fbDebugCNT							: FB_DEBUG_CounterArray;
	aCNTDebug							: ARRAY [1..10] OF UDINT;
	bResetCNT							: BOOL;

END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF bClearPackConfirmationQueue THEN
	MEMSET(ADR(stPackConfirmationQueue), 16#00, SIZEOF(stPackConfirmationQueue));
	MEMSET(ADR(stAggregationBarcode), 16#00, SIZEOF(stAggregationBarcode));
END_IF
(* rising edge OF bExecute *)
fbExecute1(CLK:= bSensor1);
fbExecute2(CLK:= bSensor2);
fbExecute3(CLK:= bSensor3);
fbExecute4(CLK:= bSensor4);

Debug();

(* add Outer to sInfeedQueue *)
IF fbExecute1.Q THEN

	stPackConfirmationQueue.aPackQueue[1]:= stConfirmationBarcode;
	stPackConfirmationQueue.nIndex := stPackConfirmationQueue.nIndex + 1;
	bEnableSesnor2 := TRUE;
END_IF

IF fbExecute2.Q AND bEnableSesnor2 THEN

	bEnableSesnor2 := FALSE;
	stPackConfirmationQueue.aPackQueue[2]:= stPackConfirmationQueue.aPackQueue[1];
	stInterimBarcodeForLabeler := stPackConfirmationQueue.aPackQueue[2];
	MEMSET(ADR(stPackConfirmationQueue.aPackQueue[1]), 16#00, SIZEOF(stPackConfirmationQueue.aPackQueue[1	]));
	bEnableSesnor3 := TRUE;

END_IF

IF fbExecute3.Q AND bEnableSesnor3 THEN
	bEnableSesnor3 := FALSE;
	stPackConfirmationQueue.aPackQueue[3]:= stPackConfirmationQueue.aPackQueue[2];
	stAggregationBarcode :=  stPackConfirmationQueue.aPackQueue[3];
	MEMSET(ADR(stPackConfirmationQueue.aPackQueue[2]), 16#00, SIZEOF(stPackConfirmationQueue.aPackQueue[2	]));

END_IF


IF fbExecute4.Q THEN
	MEMSET(ADR(stPackConfirmationQueue.aPackQueue[3]), 16#00, SIZEOF(stPackConfirmationQueue.aPackQueue[3	]));
	stPackConfirmationQueue.nIndex := stPackConfirmationQueue.nIndex- 1;

END_IF]]></ST>
    </Implementation>

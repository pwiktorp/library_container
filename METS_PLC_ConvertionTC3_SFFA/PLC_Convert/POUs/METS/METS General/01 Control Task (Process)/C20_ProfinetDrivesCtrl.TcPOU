    <Action Name="DrivesStatusInterface" Id="{a3a54323-613b-4842-932f-6858db431e08}">
      <Implementation>
        <ST><![CDATA[(*Drive 01 - Outer Sepration (PAOL)*)

IF NOT gDevice.stMachineSafety.bSafetyOK THEN
	gHMI.aG120CtrlHMI[E_DRIVE_Name.OUTER_SEPAR].stRun.bButtonState := FALSE;
END_IF

gHMI.aG120StatusHMI[E_DRIVE_Name.OUTER_SEPAR].bReadyForSwitchingOn	:=	gDevice.stMachineDevices.aDriveInterfaces[E_DRIVE_Name.OUTER_SEPAR].Q.xReadyForSwitchingOn;
gHMI.aG120StatusHMI[E_DRIVE_Name.OUTER_SEPAR].bReady	:=	gDevice.stMachineDevices.aDriveInterfaces[E_DRIVE_Name.OUTER_SEPAR].Q.xReady;
gHMI.aG120StatusHMI[E_DRIVE_Name.OUTER_SEPAR].bOperationEnable	:=	gDevice.stMachineDevices.aDriveInterfaces[E_DRIVE_Name.OUTER_SEPAR].Q.xOperationEnable;
gHMI.aG120StatusHMI[E_DRIVE_Name.OUTER_SEPAR].bFault	:=	gDevice.stMachineDevices.aDriveInterfaces[E_DRIVE_Name.OUTER_SEPAR].Q.xFault;
gHMI.aG120StatusHMI[E_DRIVE_Name.OUTER_SEPAR].nFaultCode	:=	gDevice.stMachineDevices.aDriveInterfaces[E_DRIVE_Name.OUTER_SEPAR].Q.iFaultCode;
gHMI.aG120StatusHMI[E_DRIVE_Name.OUTER_SEPAR].bAlarm	:=	gDevice.stMachineDevices.aDriveInterfaces[E_DRIVE_Name.OUTER_SEPAR].Q.xAlarm;
gHMI.aG120StatusHMI[E_DRIVE_Name.OUTER_SEPAR].nWarningCode		:=	gDevice.stMachineDevices.aDriveInterfaces[E_DRIVE_Name.OUTER_SEPAR].Q.iWarningCode;
gHMI.aG120StatusHMI[E_DRIVE_Name.OUTER_SEPAR].fActualSpeed	:= gDevice.stMachineDevices.aDriveInterfaces[E_DRIVE_Name.OUTER_SEPAR].Q.rActualSpeed;
gHMI.aG120StatusHMI[E_DRIVE_Name.OUTER_SEPAR].fCurrent	:=	 gDevice.stMachineDevices.aDriveInterfaces[E_DRIVE_Name.OUTER_SEPAR].Q.rCurrent;
gHMI.aG120StatusHMI[E_DRIVE_Name.OUTER_SEPAR].fTorque	:=	 gDevice.stMachineDevices.aDriveInterfaces[E_DRIVE_Name.OUTER_SEPAR].Q.rTorque;
gHMI.aG120StatusHMI[E_DRIVE_Name.OUTER_SEPAR].bTorqueLimitReached		:=  gDevice.stMachineDevices.aDriveInterfaces[E_DRIVE_Name.OUTER_SEPAR].Q.stExt.xTorqueLimitReached;
gHMI.aG120StatusHMI[E_DRIVE_Name.OUTER_SEPAR].bMotorOverTemp	:=  gDevice.stMachineDevices.aDriveInterfaces[E_DRIVE_Name.OUTER_SEPAR].Q.stExt.xMotorOverTemp;
gHMI.aG120StatusHMI[E_DRIVE_Name.OUTER_SEPAR].bHoldingBrake	:=	gDevice.stMachineDevices.aDriveInterfaces[E_DRIVE_Name.OUTER_SEPAR].Q.stExt.xHoldingBrake;

IF (gDevice.stMachineConfig.bPackSeparatorAnalogControl AND NOT gIOFiltered.stPackSeparationDriveOK.bStateInput) OR
	   gDevice.stMachineDevices.aDriveInterfaces[E_DRIVE_Name.OUTER_SEPAR].Q.xFault THEN

	gHMI.aG120StatusHMI[E_DRIVE_Name.OUTER_SEPAR].eDriveStatus			:= E_DRIVE_ERROR;

ELSIF (gDevice.stMachineDevices.aDriverStatus[1].bDriveRun AND gDevice.stMachineDevices.aDriverStatus[1].nDriveAnalog > 0 ) OR
	gDevice.stMachineDevices.aDriveInterfaces[E_DRIVE_Name.OUTER_SEPAR].Q.rActualSpeed > 0	 THEN

	gHMI.aG120StatusHMI[E_DRIVE_Name.OUTER_SEPAR].eDriveStatus			:= E_DRIVE_RUNING;
ELSE
	gHMI.aG120StatusHMI[E_DRIVE_Name.OUTER_SEPAR].eDriveStatus			:= E_DRIVE_SPOPPED;
END_IF

(*Drive 02 - Infeed Conveyor (CML)*)

IF NOT gDevice.stMachineSafety.bSafetyOK THEN
	gHMI.aG120CtrlHMI[E_DRIVE_Name.INFEED_CONV].stRun.bButtonState := FALSE;
END_IF

gHMI.aG120StatusHMI[E_DRIVE_Name.INFEED_CONV].bReadyForSwitchingOn	:=	gDevice.stMachineDevices.aDriveInterfaces[E_DRIVE_Name.INFEED_CONV].Q.xReadyForSwitchingOn;
gHMI.aG120StatusHMI[E_DRIVE_Name.INFEED_CONV].bReady	:=	gDevice.stMachineDevices.aDriveInterfaces[E_DRIVE_Name.INFEED_CONV].Q.xReady;
gHMI.aG120StatusHMI[E_DRIVE_Name.INFEED_CONV].bOperationEnable	:=	gDevice.stMachineDevices.aDriveInterfaces[E_DRIVE_Name.INFEED_CONV].Q.xOperationEnable;
gHMI.aG120StatusHMI[E_DRIVE_Name.INFEED_CONV].bFault	:=	gDevice.stMachineDevices.aDriveInterfaces[E_DRIVE_Name.INFEED_CONV].Q.xFault;
gHMI.aG120StatusHMI[E_DRIVE_Name.INFEED_CONV].nFaultCode	:=	gDevice.stMachineDevices.aDriveInterfaces[E_DRIVE_Name.INFEED_CONV].Q.iFaultCode;
gHMI.aG120StatusHMI[E_DRIVE_Name.INFEED_CONV].bAlarm	:=	gDevice.stMachineDevices.aDriveInterfaces[E_DRIVE_Name.INFEED_CONV].Q.xAlarm;
gHMI.aG120StatusHMI[E_DRIVE_Name.INFEED_CONV].nWarningCode		:=	gDevice.stMachineDevices.aDriveInterfaces[E_DRIVE_Name.INFEED_CONV].Q.iWarningCode;
gHMI.aG120StatusHMI[E_DRIVE_Name.INFEED_CONV].fActualSpeed	:= gDevice.stMachineDevices.aDriveInterfaces[E_DRIVE_Name.INFEED_CONV].Q.rActualSpeed;
gHMI.aG120StatusHMI[E_DRIVE_Name.INFEED_CONV].fCurrent	:=	 gDevice.stMachineDevices.aDriveInterfaces[E_DRIVE_Name.INFEED_CONV].Q.rCurrent;
gHMI.aG120StatusHMI[E_DRIVE_Name.INFEED_CONV].fTorque	:=	 gDevice.stMachineDevices.aDriveInterfaces[E_DRIVE_Name.INFEED_CONV].Q.rTorque;
gHMI.aG120StatusHMI[E_DRIVE_Name.INFEED_CONV].bTorqueLimitReached		:=  gDevice.stMachineDevices.aDriveInterfaces[E_DRIVE_Name.INFEED_CONV].Q.stExt.xTorqueLimitReached;

<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="F95_CameraTest" Id="{2731e840-bfa2-45b6-baaa-9088a04fe0de}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM F95_CameraTest
VAR
	aScannerCtrl						: ARRAY[1..3] OF FB_SCANNER_CameraSelect;
	aPackScanner						: ARRAY[1..2] OF ST_SCANNER_CameraMap;

	aCameraCtrl						: ARRAY[1..2] OF FB_SCANNER_CameraSelectExt;
	aCameraEvaluation				: ARRAY[1..2] OF FB_SCANNER_Evaluation;
	
	bTemp: BOOL;
	nCameraType	: INT := 1;


	tonEnableCameraSystem: TON;
	bEnablePackAggregationCameraSystem: BOOL;
	bEnablePackTriggeringAfterDelay: BOOL;
	
	bExtract		: BOOL;
	rtExtract		: r_trig;
	
	sDataString : T_LongString;
	sDataStringTemp1 : T_LongString := '$01ST=53;$02CT=10;DS=GZDNP5JOA3IL;OG=3;XP=-50;YP=50;AP=-88;CS=06.2;SC=0070;QS=3;PN=1;$03$04$01ST=53;$02CT=10;DS=N7E1Y89UNK3O;OG=3;XP=-50;YP=-50;AP=-88;CS=06.2;SC=0070;QS=3;PN=2;$03$04DUPA'; 
	sPartitionMark	: STRING;
	nPositionMarkPos	: UINT;
	sDataField1 : T_LongString;
	
	fbExtractAnyString		: FB_ExtractAnyString;
	sDataStringTemp2 	: T_LongString := '$01ST=53;$02CT=10;DS=GZDNP5JOA3IL;OG=3;XP=-50;YP=50;AP=-88;CS=06.2;SC=0070;QS=3;PN=1;$03$04$01ST=53;$02CT=10;DS=N7E1Y89UNK3O;OG=3;XP=-50;YP=-50;AP=-88;CS=06.2;SC=0070;QS=3;PN=2;$03$04DUPA'; 
	sDataField2		: T_LongString;
	sDataField3		: T_LongString;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[CASE nCameraType OF

1:
	CAMERA_NEWSTRUCT();
2:

	;

ELSE
;
END_CASE

//sDataString := '$01ST=53;$02CT=10;DS=GZDNP5JOA3IL;OG=3;XP=-50;YP=50;AP=-88;CS=06.2;SC=0070;QS=3;PN=1;$03$04$01ST=53;$02CT=10;DS=N7E1Y89UNK3O;OG=3;XP=-50;YP=-50;AP=-88;CS=06.2;SC=0070;QS=3;PN=2;$03$04DUPA'; 

rtExtract(CLK:=bExtract);

IF rtExtract.Q THEN
	
	//sDataStringTemp1 := sDataString;
	sPartitionMark := '$04';
	
	//nPositionMarkPos := TO_UINT(FIND2(ADR(sDataStringTemp1),ADR(sPartitionMark)));
	
	//sDataField1 := F_LongLEFT(sDataStringTemp1, TO_UINT(nPositionMarkPos)  -1); (* -1 so we don't copy the Position mark *)
	//sDataStringTemp1 := F_LongDELETE(sDataStringTemp1, nPositionMarkPos  -1 + TO_UINT(LEN(sPartitionMark)), 1);	(* Remove used data and position mark from code message string *)
	//DELETE2(ADR(sDataStringTemp1), ADR(sDataStringTemp1), SIZEOF(sDataStringTemp1), nPositionMarkPos  -1 + LEN2(ADR(sPartitionMark)), 1);
	
	//sDataStringTemp2 := sDataString;
	
	fbExtractAnyString(
	bExtractData:= TRUE, 
	nExtractChars:= 0, 
	sPrefix:= '' , 
	sSuffix:= sPartitionMark, 
	bIgnoreCase:= TRUE , 
	eExtractMode:= E_STRING_ExtrMode.WITHOUTIDENT_REMIDENT_PURGE, 
	sDataString:= sDataStringTemp2, 
	bStringFound=> , 
	sExtractedString=> sDataField2 , 
	nExtractedStringPos=> , 
	nExtractedStringLen=> , 
	nDataStringLen=> );
	
	IF NOT fbExtractAnyString.bStringFound THEN
		sDataField3 := sDataStringTemp2;
		sDataStringTemp2 := '';
		
	END_IF
END_IF]]></ST>
    </Implementation>

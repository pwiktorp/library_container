	tofValidateOACForDataNotExis				: TOF;

	rtrigRestoreCACFileDoneValid: R_TRIG;
	rtrigRestoreCACFileDoneInvalid: R_TRIG;
	tofRestoreCACFileValid: TOF;
	tofRestoreCACFileInvalid: TOF;

END_VAR]]></Declaration>

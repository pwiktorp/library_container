    <Declaration><![CDATA[PROGRAM PRG_PAOL_01_LightboxScanersCtrl
VAR

	tonEnableCameraSystem					: TON;
	bEnablePackAggregationCameraSystem		: BOOL;
	bEnablePackTriggeringAfterDelayON		: BOOL;

	tofPackAggregationCameraOFFDelay 		: TOF;
	bEnablePackTriggeringAfterDelayOFF		: BOOL;

	fbPuls							: FB_Puls;
	tonLightboxLensAirNextBlow		: TON;
	//rtLightboxLensAirBlowing		: R_TRIG;
	tonLightboxLensAirBlowing		: TOF;

	fbCameraBoxRead					: FB_2CAM_CameraBoxRead;
	aScannerCtrl					: ARRAY[1..2] OF FB_SCANNER_CameraSelect;
	aCodeDiag						: ARRAY[1..2] OF FB_SCANNER_DiagnosticLog;

	bCameraTriggersArmed			: BOOL;
	bCameraTrigger1Conditioned		: BOOL;
	bCameraTrigger2Conditioned		: BOOL;
	bCameraTrigger3Conditioned		: BOOL;
	bCameraTrigger4Conditioned		: BOOL;
	bCameraTrigger5Conditioned		: BOOL;
	bCameraTrigger6Conditioned		: BOOL;

	rtCameraTrigger					: ARRAY[0..6] OF R_TRIG;
	aCameraTrigger					: ARRAY[0..6] OF BOOL;

	fbCameraSequenceNo				: FB_2CAM_CameraSequenceNo;

	fbPackScanners_2x5Packs			: FB_2CAM_PackScanners2x5Packs;
	fbSelectCameraMap				: FB_2CAM_SelectCameraMap;

	fbAddNewOuterTriggerID			: FB_PAOL_AddNewTriggerID;
	fbMoveOuterStatusArray			: FB_PACK_MoveOuterStatusArray;	(*Actually is moving OCVPackStatusArray*)

	aAddPackCodes					: ARRAY[1..2] OF FB_2CAM_AddPackCodes;
	aPackScanner					: ARRAY[1..2] OF ST_SCANNER_CameraMap;
	aPackCameraEvaluation			: ARRAY[1..2] OF FB_SCANNER_Evaluation;

	bPackCodeDataInvalid			: BOOL;
	ctuConsecutiveDataInvalid		: CTU;

	aInfeedCamerasSync 				: ARRAY[1..2] OF FB_PAOL_InfeedCamerasSync;

	tonDelayStopOuter				: TON;


END_VAR]]></Declaration>

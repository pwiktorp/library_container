 gProcess.aRejectCountersID[25] := gProcess.stOuterRejectReasons.stOuterBarcodeNotRead.nRejectID; (*'Outer code Not Read';*)
 gProcess.aRejectCountersID[26] := gProcess.stOuterRejectReasons.stOuterBarcodeDuplicate.nRejectID; (*'code duplicate';*)
 gProcess.aRejectCountersID[27] := gProcess.stOuterRejectReasons.stOuterDataNotFound.nRejectID; (* '(OAC) not found ';*)
 gProcess.aRejectCountersID[28] := gProcess.stOuterRejectReasons.stOuterGeneralCodeError.nRejectID; (* 'Outer Label not read';*)
 gProcess.aRejectCountersID[29] := gProcess.stOuterRejectReasons.stOuterTimeOutValidation.nRejectID; (* 'Validation Timeout';*)
 gProcess.aRejectCountersID[30] := gProcess.stOuterRejectReasons.stOuterDuplicatedPackCodesFound.nRejectID; (*'duplicate pack codes';*)

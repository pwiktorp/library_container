<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="C09_MaintainFolders_ORG" Id="{88f5b35a-c517-4510-82f2-39e07268058f}" SpecialFunc="None">
    <Declaration><![CDATA[(* delete old files and delete oldest files if number of files exceeds specified number *)
PROGRAM C09_MaintainFolders_ORG
VAR
	tArchiveCheck				: TIME := t#4s;
	fbMaintainArchive			: FB_PulseGenerator;
	tDeleteTimeCheck			: TIME := t#20m;
	fbMaintainDeleteTime		: FB_PulseGenerator;
	(*tDeleteItemCheck			: TIME := t#4s;
	fbMaintainDeleteItem		: FB_PulseGenerator;*)
	nActivateBitWord			: DWORD; (* if index increase 32 bits it is necceasry to declar 64 bits var like LREAL;*)

	fbMaintainFolders			: ARRAY[1..25] OF NT_StartProcess;
	bTest	: BOOL;
	(*fbMoveOHMToArchive		: FB_OHM_MoveToArchive;*)
	(*fbMoveCACToArchive		: FB_CAC_MoveToArchive;*)
	fbMoveCHMToArchive		: FB_CHM_MoveToArchive;
	bZipCHMArchive			: BOOL;
	rtrigZipAfetrPassthrough		: R_TRIG;
	bManualZip					: BOOL;

	(*fbCompresOHMArchive		: NT_StartProcess;
	fbCompresCHMArchive		: NT_StartProcess;
	fbCompresPHMArchive		: NT_StartProcess;

	fbDeleteCHMNoLabel		: NT_StartProcess;*)

	fbRestoreTimer			: TON;
	fbRestoreOACFromCAC		: FB_CAC_RestoreOAC;
	nOCVFilesRestored			: UDINT;
	nOACFilesRestored			: UDINT;
	nCACFilesRestored			: UDINT;

	(*rtrigClearOCV				: R_TRIG;
	rtrigClearOCVError			: R_TRIG;
	rtrigClearOAC				: R_TRIG;
	rtrigClearOACError			: R_TRIG;

	fbClearOCVArchive			: FB_OCV_ClearArchive;
	fbClearOCVError			: FB_OCV_ClearArchive;
	fbClearOACArchive			: FB_OAC_ClearArchive;
	fbClearOACError			: FB_OAC_ClearArchive;

	rtrigClearOHM_FLG			: R_TRIG;
	rtrigClearCHM_FLG			: R_TRIG;

	fbClearOHM_FLG			: FB_OHM_ClearFLG;
	fbClearCHM_FLG			: FB_CHM_ClearFLG;
	btest : BOOL;*)

(********************************************************************************
		cBASE_FOLDER_ARR	: ARRAY[1..cSYSTEM_FOLDER_LIMIT] OF T_FolderName :=
			(*01*)'Bridge\',		(*02*)'Bridge\Archive\',		(*03*)'Bridge\Restore\',
			(*04*)'CAC\',		(*05*)'CAC\Archive\',		(*06*)'CAC\Error\',		(*07*)'CAC\Restore\', 	(*08*)'CAC\Restore\Archive\',
			(*09*)'CHM\',		(*10*)'CHM\Archive\',		(*11*)'CHM\Error\',		(*12*)'CHM\OK\',		(*13*)'CHM\Commissioning_Mode\',
			(*14*)'HMI\',
			(*15*)'KPI\',		(*16*)'KPI\Archive\',			(*17*)'KPI\Shift\',		(*18*)'KPI\ProdOrder\',
			(*19*)'OAC\',		(*20*)'OAC\Error\',
			(*21*)'OCV\',		(*22*)'OCV\Error\',
			(*23*)'OHM\',		(*24*)'OHM\Archive\',		(*25*)'OHM\Error\',		(*26*)'OHM\OK\',		(*27*)'OHM\Pending\',
			(*28*)'PCM\',		(*29*)'PCM\Archive\',		(*30*)'PCM\Error\',		(*31*)'PCM\Incoming\',
			(*32*)'PAC\',
			(*33*)'PHM\',		(*34*)'PHM\Archive\',		(*35*)'PHM\Error\',		(*36*)'PHM\OK\',
			(*37*)'Settings\',	(*38*)'Settings\Backups\',
			(*39*)'Templates\',
			(*40*)'Orca\',
			(*41*) 'SystemLog\';

*************************************************************************************)
END_VAR]]></Declaration>

    <Declaration><![CDATA[PROGRAM F11_InfeedConvQueueCtrl
VAR
	fbSequenceControl					: FB_SYSTEM_SeqControl;
	nSequenceStep					: INT;
	b00_Idle							: BOOL;
	b01_ScanBarcode					: BOOL;
	b20_Done							: BOOL;

	bScannerBusy						: BOOL;
	fbScanTimeout					: TON;

	rtrigScanBarcode					: R_TRIG;
	fbScanDelay						: TON;
	fbScannerCtrl						: FB_SCANNER_CameraSelect;

	sLastGoodOuterBarcode				: T_OUTER_Barcode;
	sLastManualOuterBarcode			: T_OUTER_Barcode;

	fbOuterAggregationEvaluation			: FB_SCANNER_Evaluation;
	fbInfeedConvAggregated				: FB_CTU32;

	fbAddConvQueue					: FB_CASE_AddOuterToInfeedQ;
	fbMasterListControl					: FB_CASE_MasterListControl;

	tofAggregationCameraOFFDelay 	: TOF;


	fbAverageScanTime					: FB_SYSTEM_AverageTimeDiff;
	fbPerformance1							: FB_Interval;
	fbPerformance2							: FB_Interval;
END_VAR
(*
VAR CONSTANT
	sOptions						: ST_SCANNER_Options := (eScannerType := E_MV_440SR_FULL, nImageBuffer := 1, nExpectedResp := 1);
END_VAR*)]]></Declaration>

<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="F_FILE_SplitFilename" Id="{3007a199-e486-4426-bb51-db8aa70b8679}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION F_FILE_SplitFilename : T_MaxString
VAR_INPUT
	strPathFile		: T_MaxString;
END_VAR
VAR
	nMaxIndex		: INT;
	nIndex			: INT;
	strChar			: STRING(1);
END_VAR
(*
-------------------------------------------------------------------------------------------------
Date		Version	Author	Comments
-------------------------------------------------------------------------------------------------
30/01/2015	3.00.00	PB		Moved from Sewtec_CaseTrace.lib

-------------------------------------------------------------------------------------------------
26/03/2012	1.38.00	PB		Initial release

-------------------------------------------------------------------------------------------------
*)]]></Declaration>
    <Implementation>
      <ST><![CDATA[(* total no of chars in string *)
nMaxIndex := LEN(strPathFile);

(* initialise output *)
F_FILE_SplitFilename := '';

(* scan each char in string *)
FOR nIndex := 0 TO nMaxIndex - 1 DO

	(* start from end of string *)
	strChar := MID(strPathFile, 1, nMaxIndex - nIndex);

	(* last '\' char is string separates path and file name *)
	IF strChar = '\' THEN

		F_FILE_SplitFilename := RIGHT(strPathFile, nIndex);
		EXIT;
	END_IF
END_FOR]]></ST>
    </Implementation>
    <LineIds Name="F_FILE_SplitFilename">
      <LineId Id="20" Count="18" />
    </LineIds>
  </POU>
</TcPlcObject>
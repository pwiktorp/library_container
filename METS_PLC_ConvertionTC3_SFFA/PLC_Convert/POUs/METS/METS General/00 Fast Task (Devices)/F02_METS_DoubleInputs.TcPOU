    <Declaration><![CDATA[PROGRAM F02_METS_DoubleInputs

VAR
	fbLiftComplete					: FB_IO2_DoubleInputCtrl;	(*ib61KF1_6_StackLifted_SFWM and ib62KF1_3_StackLiftedSensor*)
	fbStackComplete				: FB_IO2_DoubleInputCtrl;	(*ib61KF1_2_StackComplete_SFWM and ib62KF1_7_StackCompletedSensor*)
	fbBundleCrossPushComplete		: FB_IO2_DoubleInputCtrl;	(*ib61KF1_7_BundleCrossPush_SFWM and ib62KF1_4_BundleCrossPushSensor*)
	fbBundleTranferComplete		: FB_IO2_DoubleInputCtrl;	(*ib61KF1_4_BundleTransferComplete_SFWM and ib62KF1_8_BundleTranferCompleteSensor*)

	fbRowComplete				: FB_IO2_DoubleInputCtrl;	(*ib161KF1_3_RowComplete_SFCP and ib163KF1_2_RowCompleteSensor*)
	fbLayerComplete				: FB_IO2_DoubleInputCtrl;	(*ib161KF1_7_LayerComplete_SFCP and ib163KF1_6_LayerCompleteSensor*)
	fbCaseComplete				: FB_IO2_DoubleInputCtrl;	(*ib161KF1_4_CaseComplete_SFCP and ib163KF1_3_CaseCompleteSensor*)
	fbCaseDischarge				: FB_IO2_DoubleInputCtrl;	(*ib161KF1_8_CaseDischarged_SFCP and ib163KF1_7_CaseDischargedSensor*)
	fbCaseLabelValidationTrigSensor	: FB_IO2_DoubleInputCtrl;	(* and *)
	fbIntermediatePush				: FB_IO2_DoubleInputCtrl;	(* and *)

	fbCaseArrived					: FB_IO2_DoubleInputCtrl;
	fbCaseTransit					: FB_IO2_DoubleInputCtrl;
	fbCasePlaced					: FB_IO2_DoubleInputCtrl;
	fbPalletCompleted				: FB_IO2_DoubleInputCtrl;

	tonSettingsValideDelay			: TON;

	fbRowCompleteSensorCTU		: FB_CTU32;	(*RowComplete*)
	fbRowCompleteMachineCTU		: FB_CTU32;
	fbRowCompleteCTU				: FB_CTU32;

	fbLayerCompleteSensorCTU		: FB_CTU32;	(*LayerComplete*)
	fbLayerCompleteMachineCTU		: FB_CTU32;
	fbLayerCompleteCTU			: FB_CTU32;

	fbCaseCompleteSensorCTU		: FB_CTU32;	(*CaseComplete*)
	fbCaseCompleteMachineCTU		: FB_CTU32;
	fbCaseCompleteCTU				: FB_CTU32;

	fbCaseDischargedSensorCTU		: FB_CTU32;	(*CaseDischarged*)
	fbCaseDischargedMachineCTU		: FB_CTU32;
	fbCaseDischargedCTU			: FB_CTU32;

	fbCaseLabelValidationSensorCTU	: FB_CTU32;	(*CaseLabelValidation*)
	fbCaseLabelValidationMachineCTU	: FB_CTU32;
	fbCaseLabelValidationCTU		: FB_CTU32;

END_VAR


(*
Modification history:
Date		|	Author 		|	Remark
----------------------------------------------------------------------------------------------------
16.09.20	|	PP			|	Start Remarking.
*)]]></Declaration>

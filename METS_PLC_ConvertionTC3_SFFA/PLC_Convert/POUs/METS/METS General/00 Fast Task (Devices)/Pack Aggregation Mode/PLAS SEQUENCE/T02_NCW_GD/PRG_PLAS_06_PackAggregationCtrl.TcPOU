	tonValidationTimout					: TON;
	bValidationTimeout					: BOOL;
	bValidationTimeoutReset				: BOOL;

	(*stPackAggregationCameraOptions		: ST_SCANNER_Options := (eScannerType := E_MV_420_FULL, nImageBuffer := 1, nExpectedResp := 1);*)
	fbPackAggregationCamera				: ARRAY [2..3] OF FB_SCANNER_CameraSelect;
	fbPackAggregationEvaluation			: ARRAY [2..3] OF FB_SCANNER_Evaluation;

	rtPackAggregationCameraDone		: ARRAY [2..3] OF R_TRIG;

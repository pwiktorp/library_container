    <Action Name="ShiftActivationBit" Id="{a10af811-c787-4570-8da7-7a0544dfed28}">
      <Implementation>
        <ST><![CDATA[IF fbMaintainDeleteTime.bOutput	THEN
	IF nActivateBitWord = 0 THEN
		nActivateBitWord := 1;
	ELSE
		nActivateBitWord :=SHL(nActivateBitWord,1);
	END_IF
END_IF]]></ST>
      </Implementation>
    </Action>

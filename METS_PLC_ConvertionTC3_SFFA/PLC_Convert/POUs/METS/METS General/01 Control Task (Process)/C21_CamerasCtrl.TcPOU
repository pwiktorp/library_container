		gDevice.aCameraControl[9].stOptions.nExpectedResp := 2;
	ELSE
		gDevice.aCameraControl[9].stOptions.nExpectedResp := gDevice.stMachineConfig.aCameraSettings[9].nExpectedResp;
	END_IF

	IF gDevice.aCameraControl[9].stOptions.nExpectedResp = 2 THEN

		CASE gDevice.stMachineConfig.aCameraSettings[9].eExpectedType OF
			E_SCANNER_CodeType.DATAMARTIX:
				gDevice.aCameraControl[9].nReqProgram := 2;
			E_SCANNER_CodeType.DOTCODE:
				gDevice.aCameraControl[9].nReqProgram := 4;
			E_SCANNER_CodeType.QR:
				gDevice.aCameraControl[9].nReqProgram := 6;
			E_SCANNER_CodeType.CODE128:
				gDevice.aCameraControl[9].nReqProgram := 8;
		ELSE
			gDevice.aCameraControl[9].nReqProgram := 2;
		END_CASE
	ELSE
		CASE gDevice.stMachineConfig.aCameraSettings[9].eExpectedType OF
			E_SCANNER_CodeType.DATAMARTIX:
				gDevice.aCameraControl[9].nReqProgram := 1;
			E_SCANNER_CodeType.DOTCODE:
				gDevice.aCameraControl[9].nReqProgram := 3;
			E_SCANNER_CodeType.QR:
				gDevice.aCameraControl[9].nReqProgram := 5;
			E_SCANNER_CodeType.CODE128:
				gDevice.aCameraControl[9].nReqProgram := 7;
		ELSE
			gDevice.aCameraControl[9].nReqProgram := 1;
		END_CASE
	END_IF
END_IF]]></ST>
      </Implementation>
    </Action>

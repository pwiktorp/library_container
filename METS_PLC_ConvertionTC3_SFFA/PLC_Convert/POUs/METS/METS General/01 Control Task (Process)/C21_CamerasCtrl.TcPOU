        <ST><![CDATA[(*********************************************************CAMERA 09**********************************************************************)
gDevice.aCameraLightingIntensity[9] := F_SCANNER_LightingIntensity(gDevice.stMachineConfig.aCameraSettings[9].nLightingIntensity);

gDevice.aCameraControl[9].stOptions.bUseExternalLight := gDevice.stMachineConfig.aCameraSettings[9].bUseExternalLight;

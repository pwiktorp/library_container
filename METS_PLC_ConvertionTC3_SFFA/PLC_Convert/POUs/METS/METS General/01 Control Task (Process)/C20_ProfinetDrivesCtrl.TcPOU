    <Declaration><![CDATA[PROGRAM C20_ProfinetDrivesCtrl
VAR

	(*G_xLabellerSemaLock	: BOOL;		(* This needs to be used to make sure only 1 client is using the FB instance *)

	fbParameterDisplay		: ARRAY[1..cMAX_PROFINET_DRIVES] OF FB_ParameterDisplayWrapper;
							aProfiNetDrives         : ARRAY[1..cMAX_PROFINET_DRIVES] OF ST_ParameterControl;____					
	xModuleIsActive			: ARRAY[1..cMAX_PROFINET_DRIVES] OF BOOL;*)

	fbProfinetCtrl			: ARRAY[1..cMAX_PROFINET_DRIVES] OF FB_G120Simple_V001;

(*dummy sturcture to be replaced by global PROFINET struct once implemnted*)
{library private}
	stEmptyDriveIn								: ST_DRIVE_INPUT;
	stEmptyDriveOut								: ST_DRIVE_OUTPUT;
	nNoCheckPNetIoError							: UINT;
END_VAR
]]></Declaration>

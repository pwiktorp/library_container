<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="A10_LAB_Duplicat" Id="{0365173a-a22a-44dc-95f2-c86f7430a9c0}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM A10_LAB_Duplicat
VAR
	bInit	: BOOL;
	rtInit	: R_TRIG;
	
	bExecuteInit	: BOOL;
	bExecuteDup		: BOOL;
	bExecuteUpdate	: BOOL;
	bExecuteVal		: BOOL;
	bExecuteFinal	: BOOL;
	
	nOACFilesBlocked		: UINT;
	nOCVFilesBlocked		: UINT;
	
	rtExecute	: R_TRIG;
	
	//aOuters 	: ARRAY[1..3] OF ST_LAB_OuterData;
	
	nOuterIndex			: INT;
	nPackIndex			: INT;
	nOuterCheckIndex	: INT;
	nPackCheckIndex		: INT;


	nLastOuterIndexValue		: INT;
	nLastPackIndexValue			: INT;
	
	fbInitialiseCaseData	: FB_CASE_InitialiseData;
	fbCaseDuplicatCheck		: FB_CASE_DuplicatCheck;
	fbDuplicateUpdateToDB	: FB_CASE_DuplicateUpdateToDB;
	fbValidateCaseContent	: FB_CASE_ValidateContent;
	fbFinaliseData			: FB_CASE_FinaliseData;
	
	bCACValid			: BOOL;
	bCACInvalid			: BOOL;
	sRejectCode				: T_MaxString;
	sCaseContent			: T_LongSTRING;
	bIsDuplicateOuters		: BOOL;
	bIsDuplicatePacks		: BOOL;
	bDoorOpen				: BOOL;
END_VAR
VAR CONSTANT
		
	nMAX_OUTER	: INT :=3;
	nMAX_PACK	: INT :=3;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[
rtInit(CLK:=bInit);

IF rtInit.Q THEN
	Initialisation(aOuters, aLabCACData);
END_IF

InitCaseData();

DupCheck();

aOCVDataDB_LAB.bDone 	:= TRUE;
aOACDataDB_LAB.bDone	:= TRUE;

UpdateDB();

ValidateCaseData();

FinalCaseData();

(*
rtExecute(CLK:=bExecute);

IF rtExecute.Q THEN
	
	FOR  nOuterIndex :=1 TO nMAX_OUTER DO
		//////////////////////
		FOR nOuterCheckIndex := nOuterIndex + 1 TO nMAX_OUTER DO
			
			nLastOuterIndexValue	:= nOuterCheckIndex;
			 IF aOuters[nOuterIndex].sOuterCode = aOuters[nOuterCheckIndex].sOuterCode  THEN
				 
				aOuters[nOuterIndex].nOuterRejectID			:= 200;
				aOuters[nOuterCheckIndex].nOuterRejectID	:= 200;
			 END_IF
		END_FOR
		///////////////////////////
		FOR  nPackIndex :=1 TO nMAX_PACK DO
			FOR nPackCheckIndex := nPackIndex + 1  TO nMAX_PACK DO
				
				nLastPackIndexValue	:= nPackCheckIndex;
				 IF aOuters[nOuterIndex].aPacks[nPackIndex].sPackCode = aOuters[nOuterIndex].aPacks[nPackCheckIndex].sPackCode THEN
					 
					aOuters[nOuterIndex].aPacks[nPackIndex].nPackRejectID		:= 100;
					aOuters[nOuterIndex].aPacks[nPackCheckIndex].nPackRejectID	:= 100;
				END_IF
			END_FOR
			
			FOR nOuterCheckIndex := nOuterIndex + 1 TO nMAX_OUTER DO
				FOR nPackCheckIndex := 1  TO nMAX_PACK DO
					
					IF aOuters[nOuterIndex].aPacks[nPackIndex].sPackCode = aOuters[nOuterCheckIndex].aPacks[nPackCheckIndex].sPackCode THEN
					 
						aOuters[nOuterIndex].aPacks[nPackIndex].nPackRejectID		:= 100;
						aOuters[nOuterCheckIndex].aPacks[nPackCheckIndex].nPackRejectID	:= 100;
					END_IF
				END_FOR
			END_FOR
				
		END_FOR
		///////////////////////////////
	END_FOR
END_IF	
		*)
	(*	IF stOuterStatus.stOACData.PackCodeStatus[nPackIndex].5 OR stOuterStatus.stOACData.PackCodeStatus[nPackIndex].6 THEN

			FOR nCheckIndex :=1 TO cMAX_PACKS_PER_OUTER DO

				IF stOuterStatus.stOACData.PackCode[nPackIndex] = stLastOuterStatus.stOACData.PackCode[nCheckIndex] THEN

					stOuterStatus.nStatus.22 := TRUE;
					stOuterStatus.sDataSourceTracker  := 'PK_DUPLIC';

					stLastOuterStatus.nStatus.22 := TRUE;
					stLastOuterStatus.sDataSourceTracker  := 'PK_DUPLIC';

					EXIT;
				END_IF
			END_FOR
			EXIT;
		END_IF
	END_FOR*)]]></ST>
    </Implementation>

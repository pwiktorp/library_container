	gDevice.aCameraControl[8].stOptions.nExpectedResp := gDevice.stMachineConfig.aCameraSettings[8].nExpectedResp;


	IF gDevice.aCameraControl[8].stOptions.nExpectedResp = 2 THEN

		CASE gDevice.stMachineConfig.aCameraSettings[8].eExpectedType OF
			E_SCANNER_CodeType.DATAMARTIX:
				gDevice.aCameraControl[8].nReqProgram := 2;
			E_SCANNER_CodeType.DOTCODE:
				gDevice.aCameraControl[8].nReqProgram := 4;
			E_SCANNER_CodeType.QR:
				gDevice.aCameraControl[8].nReqProgram := 6;
			E_SCANNER_CodeType.CODE128:
				gDevice.aCameraControl[8].nReqProgram := 8;
		ELSE
			gDevice.aCameraControl[8].nReqProgram := 2;
		END_CASE
	ELSE
		CASE gDevice.stMachineConfig.aCameraSettings[8].eExpectedType OF
			E_SCANNER_CodeType.DATAMARTIX:
				gDevice.aCameraControl[8].nReqProgram := 1;
			E_SCANNER_CodeType.DOTCODE:
				gDevice.aCameraControl[8].nReqProgram := 3;
			E_SCANNER_CodeType.QR:
				gDevice.aCameraControl[8].nReqProgram := 5;
			E_SCANNER_CodeType.CODE128:
				gDevice.aCameraControl[8].nReqProgram := 7;
		ELSE

<TcPlcObject Version="1.1.0.1">
  <POU Name="C01_System" Id="{05763847-fc71-4ec4-95d0-dda019cef70f}" SpecialFunc="None">
    <Declaration><![CDATA[(* POU with components common to all METS systems *)
PROGRAM C01_System
VAR
	fbCloseTCPSockets			: FB_SocketCloseAll;
	fbBasePath				: FB_SYSTEM_HardwareOS;
	//fbSystemFolders			: FB_SYSTEM_CreateFolders;
	fbCoreFolders			: FB_SYSTEM_CoreFolders;
	fbCorePaths				: FB_SYSTEM_CorePaths;
	
	fbMETSAppPath				: FB_SYSTEM_HardwareOS;
	fbMETSLogsPath				: FB_SYSTEM_HardwareOS;
	fbMETSProcessPath			: FB_SYSTEM_HardwareOS;
	
	bMETSApp_OK				: BOOL;
	bMETSLogs_OK			: BOOL;	
	bMETSProcess_OK			: BOOL;

	fbNVDataCtrl				: FB_CX_NVData_NOVRAM;
	fbSettings					: FB_CX_NVData_XMLFile;
	fbValidateSettings			: FB_SYSTEM_ValidateSettings;
	
	
	


	fbPulseNetwork			: FB_PulseGenerator;
	fbNetworkInfo				: FB_CX_NetworkInfo;
	aDisplayInfo				: ARRAY[1..6, 1..2] OF STRING(23);

	fbCloseTCPPorts			: FB_TCP_CloseAllPorts;
	fbTCPServerInitOK			: RS;

	fbDateTime				: FB_SYSTEM_DateTime;
	fbShiftMonitor				: FB_SYSTEM_ShiftMonitor;
	fbProdMonitor				: FB_SYSTEM_ProdMonitor;

	bManualChange: BOOL;
	bManualClosePorts		: BOOL;
	aNovRAMSize				: ARRAY[0..10] OF UDINT;

	fbDelayShutdown			: TON; 			(*Time to abort shutdown*)
	fbShutDown				: NT_Shutdown;
	fbAbortShutdown			: NT_AbortShutdown;
	nShutdownDelay			: DWORD;		(*Shutdown delay time*)

END_VAR]]></Declaration>

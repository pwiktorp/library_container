    <Action Name="ReportingStatus" Id="{51f01e5b-8cb0-417d-874a-12986c85fe46}">
      <Implementation>
        <ST><![CDATA[gDevice.stReportingDB.sPLCVersionHMI				:= gHMI.sPLCVersionHMI;
gDevice.stReportingDB.sPLCVersionInfoHMI			:= gHMI.sPLCVersionInfoHMI;

gDevice.stReportingDB.stMachineID.ProductionLine	:= gDevice.stMetsStatus.stPCMStatus.sProductionLine;
gDevice.stReportingDB.stMachineID.ProductionSite	:= gDevice.stMetsStatus.stPCMStatus.sProductionSite;

MEMMOVE(ADR(gDevice.stReportingDB.stMachineState), ADR(gDevice.stMachineState),SIZEOF(gDevice.stMachineState));

gDevice.stReportingDB.bMainItemReset				:= gDevice.stMetsStatus.bLongReset;

rtStratupComplete(CLK:= gDevice.stMetsStatus.bStartUpComplete);
IF rtStratupComplete.Q	THEN
	gDevice.stReportingDB.sStartDateTime			:= F_SYSTEM_SystemTimeAsISO8601(gDevice.stMetsStatus.stCTDateTime.sSystemTime, gDevice.stMetsStatus.stCTDateTime.sUTCTimeZoneOffset );
END_IF

nShiftID	:= gDevice.stReportingDB.nShiftID;				

gDevice.stReportingDB.nCodingAndTrackingMode		:= gDevice.stMetsStatus.stPCMStatus.nOpMode;
gDevice.stReportingDB.sBatchNumber					:= gDevice.stMetsStatus.stPCMStatus.sBatchNumber;
gDevice.stReportingDB.sProductionOrder				:= gDevice.stMetsStatus.stPCMStatus.sProductionOrder;
gDevice.stReportingDB.sRetailSKU 					:= gDevice.stMetsStatus.stPCMStatus.sRetailSKU;
gDevice.stReportingDB.sProductDescription			:= gDevice.stMetsStatus.stPCMStatus.sProductDescription;

(* Amount Of  Packs per Outer unit for current PCM *)
gDevice.stReportingDB.nPacksPerOuter				:= gDevice.stMetsStatus.stPCMStatus.nPacksPerOuter;	
(* Amount Of  Packs per Case unit for current PCM *)	
gDevice.stReportingDB.nPacksPerCase					:= gDevice.stMetsStatus.stPCMStatus.nPacksPerCase;		
(* Amount Of  Outers  per Case unit for current PCM *)	
gDevice.stReportingDB.nOutersPerCase				:= gDevice.stMetsStatus.stPCMStatus.nOutersPerCase;			

FOR nCameraIndex := 1 TO cMAX_CAMERA_NUMBER DO
	gDevice.stReportingDB.aCameraName[nCameraIndex] := gDevice.stMachineConfig.aCameraSettings[nCameraIndex].sDeviceName;
END_FOR
]]></ST>
      </Implementation>
    </Action>
    <Action Name="Watchdog" Id="{b16be1d6-0538-4d14-8f37-dbffcd90d179}">
      <Implementation>
        <ST><![CDATA[(*Watchdog to Bridge*)
gDevice.nWatchdogToReportingDB := gDevice.nWatchdogToReportingDB + 1;
IF  gDevice.nWatchdogToReportingDB > 10000 THEN
	gDevice.nWatchdogToReportingDB := 1;
END_IF

gDevice.nWatchdogFromReportingDB	:=	gDevice.stReportingDB.nReportingDBWatchdog;
(*Watchdog from HMI - check if running*)
IF ton_Watchdog.Q THEN
	bWait := FALSE;
	IF gDevice.nWatchdogFromReportingDB <> nLastWatchdogFromReportingDB THEN
		gDevice.stMetsStatus.bReportingDBRunning := TRUE;
		nLastWatchdogFromReportingDB := gDevice.nWatchdogFromReportingDB;
	ELSE
		gDevice.stMetsStatus.bReportingDBRunning := FALSE;
	END_IF
ELSE
	bWait := TRUE;
END_IF

ton_Watchdog(IN:= bWait, PT := t#4000ms);]]></ST>
      </Implementation>
    </Action>
  </POU>
</TcPlcObject>
    <Method Name="Initialisation" Id="{671f1c5a-4441-4f61-aefb-2a5d3dc1257e}">
      <Declaration><![CDATA[METHOD PRIVATE Initialisation
VAR_INPUT
END_VAR
VAR_IN_OUT
	aOuters 	: ARRAY[1..3] OF ST_LAB_OuterData;
	aLabCACData	: ST_CAC_Data;
END_VAR
VAR
	nOuterIndex			: INT;
	nPackIndex			: INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[(*aOuters[1].sOuterCode	:=	'OUTER1';
aOuters[1].nOuterStatus := 5;

aOuters[1].aPacks[1].sPackCode		:= 'PACK01OUTER1';
aOuters[1].aPacks[1].nPackStatus	:= 5;
aOuters[1].aPacks[2].sPackCode		:= 'PACK02OUTER1';
aOuters[1].aPacks[2].nPackStatus	:= 5;
aOuters[1].aPacks[3].sPackCode		:= 'PACK02OUTER1';
aOuters[1].aPacks[3].nPackStatus	:= 5;

aOuters[2].sOuterCode	:= 'OUTER2';
aOuters[2].nOuterStatus := 5;

aOuters[2].aPacks[1].sPackCode		:= 'PACK01OUTER2';
aOuters[2].aPacks[1].nPackStatus	:= 5;
aOuters[2].aPacks[2].sPackCode		:= 'PACK02OUTER2';
aOuters[2].aPacks[2].nPackStatus	:= 5;
aOuters[2].aPacks[3].sPackCode		:= 'PACK02OUTER2';
aOuters[2].aPacks[3].nPackStatus	:= 5;

aOuters[3].sOuterCode	:= 'OUTER3';
aOuters[3].nOuterStatus := 5;

aOuters[3].aPacks[1].sPackCode		:= 'PACK01OUTER3';
aOuters[3].aPacks[1].nPackStatus	:= 5;
aOuters[3].aPacks[2].sPackCode		:= 'PACK02OUTER3';
aOuters[3].aPacks[2].nPackStatus	:= 5;
aOuters[3].aPacks[3].sPackCode		:= 'PACK02OUTER3';
aOuters[3].aPacks[3].nPackStatus	:= 5;
*)

MEMSET(ADR(aLabCACData), 16#00, SIZEOF(aLabCACData));

aLabCACData.NumberOfOuters			:= gDevice.stMetsStatus.stPCMStatus.nOutersPerCase;
aLabCACData.CodingAndTrackingMode	:= gDevice.stMetsStatus.stPCMStatus.nOpMode;
aLabCACData.RetailSKU				:= gDevice.stMetsStatus.stPCMStatus.sRetailSKU;

FOR nOuterIndex := 1 TO cMAX_OUTERS_PER_CASE BY 1 DO
	
	aLabCACData.Outer[nOuterIndex].Barcode 					:= CONCAT('OUTER_', INT_TO_STRING(nOuterIndex));
	aLabCACData.Outer[nOuterIndex].NumberOfPacks 			:= gDevice.stMetsStatus.stPCMStatus.nPacksPerOuter;
	aLabCACData.Outer[nOuterIndex].NumberOfLinkedPacks 		:= gDevice.stMetsStatus.stPCMStatus.nPacksPerOuter;
	aLabCACData.Outer[nOuterIndex].AcceptanceLevel 			:= gDevice.stMetsStatus.stPCMStatus.nPacksPerOuter;
	aLabCACData.Outer[nOuterIndex].CodingAndTrackingMode	:= gDevice.stMetsStatus.stPCMStatus.nOpMode;
	aLabCACData.Outer[nOuterIndex].OuterRejectCode			:= 'OK';
	
	FOR  nPackIndex :=1 TO cMAX_PACKS_PER_OUTER BY 1 DO
		aLabCACData.Outer[nOuterIndex].PackCode[nPackIndex] := F_CONCAT3(aLabCACData.Outer[nOuterIndex].Barcode,'_PACK_', INT_TO_STRING(nPackIndex));
		IF nPackIndex = 1 THEN
			aLabCACData.Outer[nOuterIndex].AggregationCodes[1]	:= aLabCACData.Outer[nOuterIndex].PackCode[nPackIndex];
		END_IF
		IF nPackIndex = 2 THEN
			aLabCACData.Outer[nOuterIndex].AggregationCodes[2]	:= aLabCACData.Outer[nOuterIndex].PackCode[nPackIndex];
		END_IF
		aLabCACData.Outer[nOuterIndex].PackCodeStatus[nPackIndex].5 := TRUE;
		aLabCACData.Outer[nOuterIndex].PackRejectCode[nPackIndex]	:= 'OK';
	END_FOR
END_FOR]]></ST>
      </Implementation>
    </Method>

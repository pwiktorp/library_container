    <Action Name="OverlapNVMemCheck" Id="{2db2671e-b517-4d81-9841-2ae9aec1008e}">
      <Implementation>
        <ST><![CDATA[gMessage.nAlarm_OverlapNVMemCheck := 0;

IF ADR(gNovRAM.stMetsEfficiencyNV) -ADR( gNovRAM.stMetsCamerasNV) <= SIZEOF(gNovRAM.stMetsCamerasNV) THEN gMessage.nAlarm_OverlapNVMemCheck.0 := TRUE; END_IF
IF ADR(gNovRAM.stCasePackerSignalsNV) -ADR( gNovRAM.stMetsEfficiencyNV) <= SIZEOF(gNovRAM.stMetsEfficiencyNV) THEN gMessage.nAlarm_OverlapNVMemCheck.1 := TRUE; END_IF
IF ADR(gNovRAM.stCaseInspactionLogNV) -ADR( gNovRAM.stCasePackerSignalsNV) <= SIZEOF(gNovRAM.stCasePackerSignalsNV) THEN gMessage.nAlarm_OverlapNVMemCheck.2 := TRUE; END_IF
IF ADR(gNovRAM.sCurrentCHMArchiveDateNameNV) -ADR( gNovRAM.stCaseInspactionLogNV) <= SIZEOF(gNovRAM.stCaseInspactionLogNV) THEN gMessage.nAlarm_OverlapNVMemCheck.3 := TRUE; END_IF
IF ADR(gNovRAM.sNewCHMArchiveDateNameNV) -ADR( gNovRAM.sCurrentCHMArchiveDateNameNV) <= SIZEOF(gNovRAM.sCurrentCHMArchiveDateNameNV) THEN gMessage.nAlarm_OverlapNVMemCheck.4 := TRUE; END_IF
IF ADR(gNovRAM.sLastSendingTimeToFactoryLayerNV) -ADR( gNovRAM.sNewCHMArchiveDateNameNV) <= SIZEOF(gNovRAM.sNewCHMArchiveDateNameNV) THEN gMessage.nAlarm_OverlapNVMemCheck.5 := TRUE; END_IF
IF ADR(gNovRAM.stShiftStatisticNV) -ADR( gNovRAM.sLastSendingTimeToFactoryLayerNV) <= SIZEOF(gNovRAM.sLastSendingTimeToFactoryLayerNV) THEN gMessage.nAlarm_OverlapNVMemCheck.6 := TRUE; END_IF
IF ADR(gNovRAM.stProdStatisticNV) -ADR( gNovRAM.stShiftStatisticNV) <= SIZEOF(gNovRAM.stShiftStatisticNV) THEN gMessage.nAlarm_OverlapNVMemCheck.7 := TRUE; END_IF
IF ADR(gNovRAM.nNVChecksum) -ADR( gNovRAM.stProdStatisticNV) <= SIZEOF(gNovRAM.stProdStatisticNV) THEN gMessage.nAlarm_OverlapNVMemCheck.8 := TRUE; END_IF


(*Alarm bits list just to display status in conviniece view*)
gMessage.nAlarm_OverlapBitDisplay.1 := gMessage.nAlarm_OverlapNVMemCheck.1;
gMessage.nAlarm_OverlapBitDisplay.2 := gMessage.nAlarm_OverlapNVMemCheck.2;
gMessage.nAlarm_OverlapBitDisplay.3 := gMessage.nAlarm_OverlapNVMemCheck.3;
gMessage.nAlarm_OverlapBitDisplay.4 := gMessage.nAlarm_OverlapNVMemCheck.4;
gMessage.nAlarm_OverlapBitDisplay.5 := gMessage.nAlarm_OverlapNVMemCheck.5;
gMessage.nAlarm_OverlapBitDisplay.6 := gMessage.nAlarm_OverlapNVMemCheck.6;
gMessage.nAlarm_OverlapBitDisplay.7 := gMessage.nAlarm_OverlapNVMemCheck.7;
gMessage.nAlarm_OverlapBitDisplay.8 := gMessage.nAlarm_OverlapNVMemCheck.8;


aNovRAMSize[0] 	:= SIZEOF(gNovRAM.bInitBit);
aNovRAMSize[1]	:= SIZEOF(gNovRAM.stMetsCamerasNV);
aNovRAMSize[2] 	:= SIZEOF(gNovRAM.stMetsEfficiencyNV);
aNovRAMSize[3] 	:= SIZEOF(gNovRAM.stCasePackerSignalsNV);
aNovRAMSize[4] 	:= SIZEOF(gNovRAM.stCaseInspactionLogNV);
aNovRAMSize[5] 	:= SIZEOF(gNovRAM.sCurrentCHMArchiveDateNameNV);
aNovRAMSize[6] 	:= SIZEOF(gNovRAM.sNewCHMArchiveDateNameNV);
aNovRAMSize[7] 	:= SIZEOF(gNovRAM.sLastSendingTimeToFactoryLayerNV);
aNovRAMSize[8] 	:= SIZEOF(gNovRAM.stShiftStatisticNV);
aNovRAMSize[9]	:= SIZEOF(gNovRAM.stProdStatisticNV);
aNovRAMSize[10]	:= SIZEOF(gNovRAM.nNVChecksum);

]]></ST>
      </Implementation>
    </Action>
    <Action Name="RejectReasonMapping" Id="{d5b2d0b7-242b-4ef2-a1d8-0fd66bd57188}">
      <Implementation>
        <ST><![CDATA[(*********************Reject Code Mapping for Shift Statistic****************************)

 gProcess.aRejectCountersID[0] := gProcess.stPackRejectReasons.stUnknownPackReject.nRejectID;  (*'UnknownReason';*)
 gProcess.aRejectCountersID[1] := gProcess.stPackRejectReasons.stPackCodesNotLinked.nRejectID; (*'Pack code(s) not linked';*)
 gProcess.aRejectCountersID[2] := gProcess.stPackRejectReasons.stPackCodesOverwritten.nRejectID; (* 'Pack code(s) over-written';*)
 gProcess.aRejectCountersID[3] := gProcess.stPackRejectReasons.stPackCodesGtinError.nRejectID; (* 'Pack code(s) invalid GTIN';*)
 gProcess.aRejectCountersID[4] := gProcess.stPackRejectReasons.stPackCodesSerialError.nRejectID; (*'Pack code(s) invalid Serial Code';*)
 gProcess.aRejectCountersID[5] := gProcess.stPackRejectReasons.stPackCodeInvalidLength.nRejectID; (*'Pack code(s) invalid Length';*)
 gProcess.aRejectCountersID[6] := gProcess.stPackRejectReasons.stPackCodesNotRead.nRejectID; (*'Pack code(s) no read';*)
 gProcess.aRejectCountersID[7] := gProcess.stPackRejectReasons.stPackCodesDuplicated.nRejectID; (*'Pack code(s) duplicate';*)
 gProcess.aRejectCountersID[8] := gProcess.stPackRejectReasons.stPackCodesTypeError.nRejectID; (*'Pack code(s) invalid type';*)
 gProcess.aRejectCountersID[9] := gProcess.stPackRejectReasons.stPackCodesSUPIError.nRejectID; (*'Pack code(s) SUPI failed validation';*)
 gProcess.aRejectCountersID[10] := gProcess.stPackRejectReasons.stPackCodesDBError.nRejectID;  (*'Pack code DB failed validation';*)
 gProcess.aRejectCountersID[11] := gProcess.stPackRejectReasons.stPackCodesBrandSpec.nRejectID; (*'Pack code(s) invalid Brand';*)
 gProcess.aRejectCountersID[12] := 1000;
 gProcess.aRejectCountersID[13] := 1000;
 gProcess.aRejectCountersID[14] := 1000;
 gProcess.aRejectCountersID[15] := 1000;

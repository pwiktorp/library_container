        <ST><![CDATA[(*********************************************************CAMERA 07**********************************************************************)
gDevice.aCameraLightingIntensity[7] := F_SCANNER_LightingIntensity(gDevice.stMachineConfig.aCameraSettings[7].nLightingIntensity);

gDevice.aCameraControl[7].stOptions.bUseExternalLight := gDevice.stMachineConfig.aCameraSettings[7].bUseExternalLight;
gDevice.aCameraControl[7].stOptions.eScannerType	:= gDevice.stMachineConfig.aCameraSettings[7].eScannerType;

IF gDevice.aCameraControl[7].stOptions.eScannerType = E_SCANNER_DeviceType.V430F THEN

	gDevice.aCameraControl[7].stOptions.nImageBuffer	:= 1;
	gDevice.aCameraControl[7].stOptions.nExpectedResp := 1;
	gDevice.aCameraControl[7].nReqProgram := 1;

ELSE

	gDevice.aCameraControl[7].stOptions.nImageBuffer 	:= gDevice.stMachineConfig.aCameraSettings[7].nImageBuffer;

	IF gDevice.stMachineConfig.bMasterListCameraDoubleRead AND NOT gDevice.stMachineConfig.bEANValidationEnable THEN
		gDevice.aCameraControl[7].stOptions.nExpectedResp := 2;
	ELSE
		gDevice.aCameraControl[7].stOptions.nExpectedResp := gDevice.stMachineConfig.aCameraSettings[7].nExpectedResp;
	END_IF

	CASE gDevice.stMachineConfig.aCameraSettings[7].eExpectedType OF
			E_SCANNER_CodeType.DATAMARTIX:
				gDevice.aCameraControl[7].nReqProgram := 1;
			E_SCANNER_CodeType.DOTCODE:
				gDevice.aCameraControl[7].nReqProgram := 2;
			E_SCANNER_CodeType.QR:
				gDevice.aCameraControl[7].nReqProgram := 3;
			E_SCANNER_CodeType.CODE128:
				gDevice.aCameraControl[7].nReqProgram := 4;
		ELSE

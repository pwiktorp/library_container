    <Folder Name="01 Main" Id="{0bed1d7a-f58c-47a5-bc26-ffa74ef3a344}" />
    <Folder Name="02 Negative" Id="{63a8b0a9-1f14-40e0-93f8-136d23ea418b}" />
    <Folder Name="03 Sequence" Id="{885129a0-284d-418b-b394-efe61bfcf3fc}" />
    <Folder Name="99 Others" Id="{fdfd9971-f1c8-46e2-b654-fe92c11d60c4}" />
    <Method Name="FbExtrctAnyStringTests_ExtractPrefLenght_StringExtracted" Id="{34d9bb77-0ff5-44cd-8ea7-3bf04b5ddafa}" FolderPath="99 Others\">
      <Declaration><![CDATA[METHOD INTERNAL FbExtrctAnyStringTests_ExtractPrefLenght_StringExtracted 
VAR_INST
	fbSut 	: FB_ExtractAnyString;
	sDataString		: T_LongSTRING := 'ABCDEFGHIJKL'; 
	sResult : T_LongSTRING;	// Result
END_VAR
//FB_ExtractAnyString]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('FbExtrctAnyStringTests_ExtractPrefLenght_StringExtracted');

fbSut(
	bExtractData:= TRUE, 
	nExtractChars:= 3 , 
	sPrefix:='E' , 
	sSuffix:= '', 
	bIgnoreCase:= FALSE, 
	eExtractMode := E_STRING_ExtrMode.WITHOUTIDENT_PURGE, 
	sDataString:= sDataString, 
	bStringFound=> , 
	sExtractedString=>sResult, 
	nExtractedStringPos=> ,
	nExtractedStringLen=> ,
	nDataStringLen=> );
	
	
	AssertEquals_STRING(	Expected:= 'FGH', 
						Actual:= fbSut.sExtractedString, 
						Message:= 'Extracted string is not as expected');
						
	AssertEquals_STRING(	Expected:= 'IJKL', 
						Actual:= sDataString, 
						Message:= 'Remaining string is not as expected');
						
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="FbExtrctAnyStringTests_ExtractPrefLenghtToLong_EmptyString" Id="{d1600533-bd0d-4a88-9d0d-cb007d8f755a}" FolderPath="99 Others\">
      <Declaration><![CDATA[METHOD INTERNAL FbExtrctAnyStringTests_ExtractPrefLenghtToLong_EmptyString 
VAR_INST
	fbSut 	: FB_ExtractAnyString;
	sDataString		: T_LongSTRING := 'ABCDEFGHIJKL'; 
	sResult : T_LongSTRING;	// Result
END_VAR
//FB_ExtractAnyString]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('FbExtrctAnyStringTests_ExtractPrefLenghtToLong_EmptyString');

fbSut(
	bExtractData:= TRUE, 
	nExtractChars:= 15 , 
	sPrefix:='B' , 
	sSuffix:= '', 
	bIgnoreCase:= FALSE, 
	eExtractMode := E_STRING_ExtrMode.WITHOUTIDENT_PURGE, 
	sDataString:= sDataString, 
	bStringFound=> , 
	sExtractedString=>sResult, 
	nExtractedStringPos=> ,
	nExtractedStringLen=> ,
	nDataStringLen=> );
	
	
	AssertEquals_STRING(	Expected:= 'CDEFGHIJKL', 
						Actual:= fbSut.sExtractedString, 
						Message:= 'Extracted string is not as expected');
						
	AssertEquals_STRING(	Expected:= '', 
						Actual:= sDataString, 
						Message:= 'Remaining string is not as expected');
						
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testMain01_ModeWITHIDENT_ExactDataNoPurge" Id="{1b0843fb-4604-453c-8562-7072601b2b6b}" FolderPath="01 Main\">
      <Declaration><![CDATA[METHOD INTERNAL testMain01_ModeWITHIDENT_ExactDataNoPurge
VAR
	fbSut 			: FB_ExtractAnyString;
	sDataString		: T_LongSTRING := '$01ST=53;$02CT=10;DS=]d201062533414058582101485MV125000156300$1D24010120957;OG=3;XP=94;YP=-39;AP=-88;CS=06.2;SC=0070;PN=1;QS=3;$03$04'; 
	sResult 		: T_LongSTRING;	// Result
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('testMain01_ModeWITHIDENT_ExactDataNoPurge');

fbSut(
	bExtractData:= TRUE, 
	nExtractChars:=0 , 
	sPrefix:='DS=' , 
	sSuffix:= ';OG', 
	bIgnoreCase:= FALSE, 
	eExtractMode := E_STRING_ExtrMode.WITHIDENT, 
	sDataString:= sDataString, 
	bStringFound=> , 
	sExtractedString=>sResult, 
	nExtractedStringPos=> ,
	nExtractedStringLen=> ,
	nDataStringLen=> );
	
	
	AssertEquals_STRING(	Expected:= 'DS=]d201062533414058582101485MV125000156300$1D24010120957;OG', 
						Actual:= sResult, 
						Message:= 'Extracted string is not as expected');
						
	AssertEquals_STRING(	Expected:= '$01ST=53;$02CT=10;=3;XP=94;YP=-39;AP=-88;CS=06.2;SC=0070;PN=1;QS=3;$03$04', 
						Actual:= sDataString, 
						Message:= 'Remaining string is not as expected');
						
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testMain02_ModeWITHIDENTPURGE_ExactDataAndPurge" Id="{c1186f7c-c0e9-4f48-94ab-b4bc75454a04}" FolderPath="01 Main\">
      <Declaration><![CDATA[METHOD INTERNAL testMain02_ModeWITHIDENTPURGE_ExactDataAndPurge
VAR
	fbSut 			: FB_ExtractAnyString;
	sDataString		: T_LongSTRING := '$01ST=53;$02CT=10;DS=]d201062533414058582101485MV125000156300$1D24010120957;OG=3;XP=94;YP=-39;AP=-88;CS=06.2;SC=0070;PN=1;QS=3;$03$04'; 
	sResult 		: T_LongSTRING;	// Result
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('testMain02_ModeWITHIDENTPURGE_ExactDataAndPurge');

fbSut(
	bExtractData:= TRUE, 
	nExtractChars:=0 , 
	sPrefix:='DS=' , 
	sSuffix:= ';OG', 
	bIgnoreCase:= FALSE, 
	eExtractMode := E_STRING_ExtrMode.WITHIDENT_PURGE, 
	sDataString:= sDataString, 
	bStringFound=> , 
	sExtractedString=>sResult, 
	nExtractedStringPos=> ,
	nExtractedStringLen=> ,
	nDataStringLen=> );
	
	
	AssertEquals_STRING(	Expected:= 'DS=]d201062533414058582101485MV125000156300$1D24010120957;OG', 
						Actual:= sResult, 
						Message:= 'Extracted string is not as expected');
						
	AssertEquals_STRING(	Expected:= '=3;XP=94;YP=-39;AP=-88;CS=06.2;SC=0070;PN=1;QS=3;$03$04', 
						Actual:= sDataString, 
						Message:= 'Remaining string is not as expected');
						
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>

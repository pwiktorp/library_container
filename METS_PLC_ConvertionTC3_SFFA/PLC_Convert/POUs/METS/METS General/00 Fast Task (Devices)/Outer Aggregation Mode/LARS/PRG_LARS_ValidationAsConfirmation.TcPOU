	bDataReadyForValidation				: BOOL;
	bQAReject								: BOOL;

	sLastImageLableString				: T_OUTER_Barcode;

	fbMoveOuterData						: FB_OUTER_MoveOuterStatus;
	fbCompleteDataFromConfirmation	: FB_OUTER_CompleteDataFromDB_SingleCam;
	fbMETSValidateOuterForReject			: FB_OUTER_ValidateOuterForReject;
	tofValidateOuterDoneForHMI			: TOF;
	fbMasterListUpdate					: FB_OUTER_MasterListUpdate;

	stLastOuterCompleted					: ST_OUTER_Status;
	sLastReadOuterBarcode				: T_OUTER_Barcode;
	sLastReadConfPackCode1				: T_PACK_Barcode;
	nOutersCompleted						: UDINT;
	bDoneInfo								: BOOL;

	rtrigSetOuterValidationOK			: R_TRIG;
	rtrigSetOuterValidationNOK		: R_TRIG;

	rsOuterRejectStation 				: RS;
	rsOuterRejectConfirmation 		: RS;

	rtrigResetValidationStatus			: R_TRIG;

	sRejectCode						: STRING(255);
	fbArchiveInvalidOuters			: FB_OUTER_ArchiveInvalidOuters;
	aReasonForReject					: ARRAY[0..50] OF STRING(255);
	bClearList							: BOOL;

	fbOuterProduced					: FB_KPI_GenericEfficiency;
	fbOuterInspection					: FB_KPI_OutersEfficiency;

	fbOuterLevelCounter				: FB_KPI_OuterLevelCounter;

	fbQARejectCounter				: FB_CTU32;
	fbOuterValidationIndexOK			: FB_CTU32;

	ctuConsecutiveOuterRejects		: CTU;
	nActualCount						: WORD;

	stDummyImageData			: ST_SCANNER_ImageData;		(* image data structure *)
	aDistanceCheck				: ARRAY[1..2] OF FB_TimeDistance;
	bResetCTU						: BOOL;
END_VAR]]></Declaration>

				gDevice.aCameraControl[11].nReqProgram := 2;
			E_SCANNER_CodeType.QR:
				gDevice.aCameraControl[11].nReqProgram := 3;
			E_SCANNER_CodeType.CODE128:
				gDevice.aCameraControl[11].nReqProgram := 4;
		ELSE
			gDevice.aCameraControl[11].nReqProgram := 1;
		END_CASE
END_IF]]></ST>
      </Implementation>
    </Action>
    <Action Name="Camera12" Id="{ecfccefb-3927-4f0c-9372-3a1ca5f9b0d8}">
      <Implementation>
        <ST><![CDATA[(*********************************************************CAMERA 12**********************************************************************)
gDevice.aCameraLightingIntensity[12] := F_SCANNER_LightingIntensity(gDevice.stMachineConfig.aCameraSettings[12].nLightingIntensity);

gDevice.aCameraControl[12].stOptions.bUseExternalLight := gDevice.stMachineConfig.aCameraSettings[12].bUseExternalLight;
gDevice.aCameraControl[12].stOptions.eScannerType	:= gDevice.stMachineConfig.aCameraSettings[12].eScannerType;

IF gDevice.aCameraControl[12].stOptions.eScannerType = E_SCANNER_DeviceType.V430F THEN

	gDevice.aCameraControl[12].stOptions.nImageBuffer	:= 1;
	gDevice.aCameraControl[12].stOptions.nExpectedResp := 1;
	gDevice.aCameraControl[12].nReqProgram := 1;

ELSIF gDevice.stMetsStatus.stPCMStatus.nOpMode < 7 THEN

	gDevice.aCameraControl[12].stOptions.nImageBuffer	:= 1;
	gDevice.aCameraControl[12].stOptions.nExpectedResp := 1;
	gDevice.aCameraControl[12].nReqProgram := 5;

ELSE

	gDevice.aCameraControl[12].stOptions.nImageBuffer 	:= gDevice.stMachineConfig.aCameraSettings[12].nImageBuffer;
	gDevice.aCameraControl[12].stOptions.nExpectedResp := gDevice.stMachineConfig.aCameraSettings[12].nExpectedResp;

	CASE gDevice.stMachineConfig.aCameraSettings[12].eExpectedType OF
			E_SCANNER_CodeType.DATAMARTIX:
				gDevice.aCameraControl[12].nReqProgram := 1;
			E_SCANNER_CodeType.DOTCODE:
				gDevice.aCameraControl[12].nReqProgram := 2;
			E_SCANNER_CodeType.QR:
				gDevice.aCameraControl[12].nReqProgram := 3;
			E_SCANNER_CodeType.CODE128:
				gDevice.aCameraControl[12].nReqProgram := 4;
		ELSE
			gDevice.aCameraControl[12].nReqProgram := 1;
		END_CASE
END_IF]]></ST>
      </Implementation>
    </Action>
  </POU>
</TcPlcObject>
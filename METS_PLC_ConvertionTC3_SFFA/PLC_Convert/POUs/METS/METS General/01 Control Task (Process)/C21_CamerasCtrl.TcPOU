IF gDevice.aCameraControl[9].stOptions.eScannerType = E_SCANNER_DeviceType.V430F THEN

	gDevice.aCameraControl[9].stOptions.nImageBuffer	:= 1;
	gDevice.aCameraControl[9].stOptions.nExpectedResp := 1;
	gDevice.aCameraControl[9].nReqProgram := 1;

ELSIF gDevice.stMachineConfig.bPassthrough AND gDevice.stMachineConfig.bEANValidationEnable THEN

	gDevice.aCameraControl[9].stOptions.nImageBuffer	:= 1;
	gDevice.aCameraControl[9].stOptions.nExpectedResp := 1;
	gDevice.aCameraControl[9].nReqProgram := 3;


<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_GS1_ValidateExplicitCode" Id="{e64bcaeb-a4f2-4c3e-8531-7dc6c7211b5a}" SpecialFunc="None">
    <Declaration><![CDATA[ FUNCTION_BLOCK FB_GS1_ValidateExplicitCode
VAR_INPUT
	sFullCode					: T_MaxString;
	stCodeInfo				: ST_GS1_CodeInfo;
	stGS1_AI_Definition			: ST_GS1_AI_Definition;
END_VAR
VAR_OUTPUT
	bValidationOK				: BOOL;
	bEntireCodeLengthOK		: BOOL;

	(*bGS1_01_OK	: BOOL;
	bGS1_10_OK	: BOOL;
	bGS1_11_OK	: BOOL;
	bGS1_15_OK	: BOOL;
	bGS1_17_OK	: BOOL;
	bGS1_21_OK	: BOOL;
	bGS1_91_OK	: BOOL;
	bGS1_92_OK	: BOOL;
	bGS1_93_OK	: BOOL;
	bGS1_94_OK	: BOOL;
	bGS1_240_OK	: BOOL;
	bGS1_8005_OK	: BOOL;

	(*Fixed string lenght according to max string lenght form GS1*)
	sGS1_01		:STRING(14);
	sGS1_10		:STRING(20);
	sGS1_11		:STRING(6);
	sGS1_15		:STRING(6);
	sGS1_17		:STRING(6);
	sGS1_21		:STRING(21);
	sGS1_91		:STRING(90);
	sGS1_92		:STRING(90);
	sGS1_93		:STRING(90);
	sGS1_94		:STRING(90);
	sGS1_240		:STRING(30);
	sGS1_8005	:STRING(6);*)

END_VAR
VAR
	stItem			: ST_GS1_CodeValidation;
	nItemIndex		: INT;

	sAI_01ToValidateAgainst		: STRING(14);

	bGS1_01_OK	: BOOL;
	bGS1_10_OK	: BOOL;
	bGS1_11_OK	: BOOL;
	bGS1_15_OK	: BOOL;
	bGS1_17_OK	: BOOL;
	bGS1_21_OK	: BOOL;
	bGS1_240_OK	: BOOL;
	bGS1_8005_OK	: BOOL;
	bGS1_8006_OK	: BOOL;
	bGS1_8008_OK	: BOOL;
	bGS1_91_OK	: BOOL;
	bGS1_92_OK	: BOOL;
	bGS1_93_OK	: BOOL;
	bGS1_94_OK	: BOOL;

	bNON_GS1_01_OK	: BOOL;
	bNON_GS1_02_OK	: BOOL;
	bNON_GS1_03_OK	: BOOL;
	bNON_GS1_04_OK	: BOOL;
	bNON_GS1_05_OK	: BOOL;
	bNON_GS1_06_OK	: BOOL;
	bNON_GS1_07_OK	: BOOL;
	bNON_GS1_08_OK	: BOOL;
	bNON_GS1_09_OK	: BOOL;
	bNON_GS1_10_OK	: BOOL;

	(*Fixed string lenght according to max string lenght form GS1*)
	sGS1_01		:STRING(14);
	sGS1_10		:STRING(20);
	sGS1_11		:STRING(6);
	sGS1_15		:STRING(6);
	sGS1_17		:STRING(6);
	sGS1_21		:STRING(20);
	sGS1_240		:STRING(30);
	sGS1_8005	:STRING(6);
	sGS1_8006	:STRING(18);
	sGS1_8008	:STRING(12);
	sGS1_91		:STRING(90);
	sGS1_92		:STRING(90);
	sGS1_93		:STRING(90);
	sGS1_94		:STRING(90);

	sNON_GS1_01		:STRING(255);
	sNON_GS1_02		:STRING(255);
	sNON_GS1_03		:STRING(255);
	sNON_GS1_04		:STRING(255);
	sNON_GS1_05		:STRING(255);
	sNON_GS1_06		:STRING(255);
	sNON_GS1_07		:STRING(255);
	sNON_GS1_08		:STRING(255);
	sNON_GS1_09		:STRING(255);
	sNON_GS1_10		:STRING(255);

END_VAR

]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF	stCodeInfo.nEntireLength = 0 THEN
	bEntireCodeLengthOK := FALSE;
	RETURN;
ELSIF	stCodeInfo.nEntireLength = stCodeInfo.nMinLength THEN
	bEntireCodeLengthOK := (LEN(sFullCode) = stCodeInfo.nEntireLength) OR NOT stCodeInfo.bValidateEntireLength;
ELSE
	bEntireCodeLengthOK := (LEN(sFullCode) >= stCodeInfo.nMinLength  AND   LEN(sFullCode) <= stCodeInfo.nEntireLength) OR NOT stCodeInfo.bValidateEntireLength;
END_IF

CASE stCodeInfo.eCodeLvlType OF

	E_LEVEL1:
		sAI_01ToValidateAgainst := stGS1_AI_Definition.stAI_01_Lvl1.sDataField;
	E_LEVEL2:
		sAI_01ToValidateAgainst := stGS1_AI_Definition.stAI_01_Lvl2.sDataField;
	E_LEVEL3:
		sAI_01ToValidateAgainst := stGS1_AI_Definition.stAI_01_Lvl3.sDataField;
ELSE
		sAI_01ToValidateAgainst := '';
END_CASE

sGS1_01		:='';
sGS1_10		:='';
sGS1_11		:='';
sGS1_15		:='';
sGS1_17		:='';
sGS1_21		:='';
sGS1_91		:='';
sGS1_92		:='';
sGS1_93		:='';
sGS1_94		:='';
sGS1_240		:='';
sGS1_8005	:='';

(*********************** GS1_01**************************************)
bGS1_01_OK := FALSE;
sGS1_01 := F_GS1_GetItem(sFullCode, GS1_01, stCodeInfo);

FOR nItemIndex :=1 TO cMAX_VALIDATION_ITEMS DO
	IF stCodeInfo.stGS1_Field[nItemIndex].eGS1_AIType =  GS1_01 THEN
		stItem := stCodeInfo.stGS1_Field[nItemIndex];
		IF stItem.bValidate THEN
			IF (LEN(sGS1_01) =  stItem.nCodeLength OR stItem.nCodeLength = 0)  AND  (sGS1_01 = sAI_01ToValidateAgainst OR sAI_01ToValidateAgainst = '') THEN
				bGS1_01_OK := TRUE;
			END_IF
		ELSE
			bGS1_01_OK := TRUE;
		END_IF
		EXIT;
	END_IF
END_FOR

(*********************** ********************************************)
(*********************** GS1_10**************************************)
bGS1_10_OK := FALSE;

			IF (LEN(sGS1_10) = stItem.nCodeLength OR stItem.nCodeLength = 0) AND ( sGS1_10 =  stGS1_AI_Definition.stAI_10.sDataField OR stGS1_AI_Definition.stAI_10.sDataField = '') THEN
				bGS1_10_OK := TRUE;

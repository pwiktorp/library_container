    <Action Name="CodesGetItem" Id="{f9a4654e-b2d6-4757-a308-e8c919983a19}">
      <Implementation>
        <ST><![CDATA[IF stMetsStatus.stPCMStatus.nOutersPerCase > 0 AND stMetsStatus.stPCMStatus.nPacksPerOuter > 0 THEN

	sCaseSerialCode := F_CODE_GetItem(stCaseQueue.stPrintCACData.Barcode, eCodeAIType.SerialCode, stMachineConfig.stCodeInfo_Case);
	sFirstOuterInCase := F_CODE_GetItem(stCaseQueue.stPrintCACData.Outer[1].Barcode, eCodeAIType.SerialCode, stMachineConfig.stCodeInfo_Outer);
	sLastOuterInCase := F_CODE_GetItem(stCaseQueue.stPrintCACData.Outer[stMetsStatus.stPCMStatus.nOutersPerCase].Barcode, eCodeAIType.SerialCode, stMachineConfig.stCodeInfo_Outer);
	sFirstPackSerialCode := F_CODE_GetItem(stCaseQueue.stPrintCACData.Outer[1].PackCode[1], eCodeAIType.SerialCode, stMachineConfig.stCodeInfo_Pack);
	sLastPackSerialCode := F_CODE_GetItem(stCaseQueue.stPrintCACData.Outer[stMetsStatus.stPCMStatus.nOutersPerCase].PackCode[stMetsStatus.stPCMStatus.nPacksPerOuter], eCodeAIType.SerialCode, stMachineConfig.stCodeInfo_Pack);

	sFirstOuterInCase	:= RIGHT(sFirstOuterInCase,7);
	sLastOuterInCase	:= RIGHT(sLastOuterInCase,7);
	sFirstPackSerialCode	:= RIGHT(sFirstPackSerialCode,7);
	sLastPackSerialCode	:= RIGHT(sLastPackSerialCode,7);

	sPrintCaseContent  := F_CONCAT9('Init OUT ID [',sFirstOuterInCase, '] ; Last OUT ID [', sLastOuterInCase,  '] ; Init PK ID [',sFirstPackSerialCode, '] ; Last PK ID [', sLastPackSerialCode,']');
END_IF]]></ST>
      </Implementation>
    </Action>
  </POU>
</TcPlcObject>
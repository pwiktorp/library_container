<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="F_SYSTEM_Time" Id="{da2ed308-1b38-4641-b3fb-b9e89100dd3b}" SpecialFunc="None">
    <Declaration><![CDATA[(* generate time as HHMMSS from TIMESTRUCT value *)
FUNCTION F_SYSTEM_Time : STRING(6)
VAR_INPUT
	sTime		: TIMESTRUCT;
END_VAR
VAR
END_VAR
(*
-------------------------------------------------------------------------------------------------
Date		Version	Author	Comments
-------------------------------------------------------------------------------------------------
03/08/2012	1.39.00	PB		Initial release

-------------------------------------------------------------------------------------------------
*)
]]></Declaration>
    <Implementation>
      <ST><![CDATA[F_SYSTEM_Time := F_CONCAT3(F_ZeroPadString(WORD_TO_STRING(sTime.wHour), 2),
							F_ZeroPadString(WORD_TO_STRING(sTime.wMinute), 2),
							F_ZeroPadString(WORD_TO_STRING(sTime.wSecond), 2));]]></ST>
    </Implementation>
    <LineIds Name="F_SYSTEM_Time">
      <LineId Id="16" Count="2" />
    </LineIds>
  </POU>
</TcPlcObject>
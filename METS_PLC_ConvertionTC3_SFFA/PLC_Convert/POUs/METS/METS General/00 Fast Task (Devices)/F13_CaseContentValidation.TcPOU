  <POU Name="F13_CaseContentValidation" Id="{eac62277-b0e6-4cfb-8f91-662618ec0800}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM F13_CaseContentValidation
VAR
	fbCrossPushCounter					: CTU;
	bCaseCompleteInsidePacker			: BOOL;


	rtrigSetEarlyCaseValidationOK			: R_TRIG;
	rtrigSetEarlyCaseValidationNOK		: R_TRIG;

	fbBiuldPackerLogString	: FB_CASE_BiuldPackerLogString;
	fbShiftPackerQueue		: FB_CASE_ShiftPackerQueue;
	fbMovePackerToCase		: FB_CASE_MovePackerToCase;
	
	fbInitialiseCaseData	: FB_CASE_InitialiseData;

	fbValidateCaseContent	: FB_CASE_ValidateContent;
	fbFinaliseCaseData		: FB_CASE_FinaliseData;
	

	
	
	//fbFinaliseCaseData					: FB_CASE_FinaliseCaseData;

	fbValidationIndexOK					: FB_CTU32;
	fbValidationIndexNoData				: FB_CTU32;
	fbValidationIndexUnder				: FB_CTU32;
	fbValidationIndexOver				: FB_CTU32;


	fbDebugCNT				: FB_DEBUG_CounterArray;
	aCNTDebug				: ARRAY [1..10] OF UDINT;
	bResetCNT					: BOOL;


END_VAR

(*
Modification history:
Date		|	Author 		|	Remark
----------------------------------------------------------------------------------------------------
02.09.20	|	PP			|	Start Remarking.
*)
]]></Declaration>

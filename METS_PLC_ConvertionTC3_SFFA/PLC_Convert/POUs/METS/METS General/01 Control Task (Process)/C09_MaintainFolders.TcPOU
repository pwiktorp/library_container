<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="C09_MaintainFolders" Id="{b89b74f7-3658-4720-addf-2afb9a9065cd}" SpecialFunc="None">
    <Declaration><![CDATA[(* delete old files and delete oldest files if number of files exceeds specified number *)
PROGRAM C09_MaintainFolders
VAR
	tArchiveCheck				: TIME := t#4s;
	fbMaintainArchive			: FB_PulseGenerator;
	tDeleteTimeCheck			: TIME := t#20m;
	fbMaintainDeleteTime		: FB_PulseGenerator;
	tClearProcessFolders		: TIME := T#500MS;
	tofClearProcessFolders		: TOF;
	
	nActivateBitWord			: DWORD; (* if index increase 32 bits it is necceasry to declar 64 bits var like LREAL;*)

	aMaintainFolders			: ARRAY[1..18] OF NT_StartProcess;
	aManualMaintain				: ARRAY[1..18] OF BOOL;

	fbMoveCHMToArchive			: FB_CHM_MoveToArchive;
	bZipCHMArchive				: BOOL;
	rtrigZipAfetrPassthrough	: R_TRIG;
	bManualZip					: BOOL;
	
(********************************************************************************
cMETS_CORE_FOLDERS					: ARRAY[1..cSYSTEM_FOLDER_LIMIT] OF T_FolderName :=[
			(*01*)'CHM\',		(*02*)'CHM\Archive\',		(*03*)'CHM\Error\',		(*04*)'CHM\OK\',		(*05*)'CHM\Commissioning_Mode\',	(*06*)'CHM\Restore\',
			(*07*)'PCM\',		(*08*)'PCM\Archive\',		(*09*)'PCM\Error\',		(*10*)'PCM\Incoming\',
			(*11*)'Settings\',	(*12*)'Settings\Backups\',	(*13*)'Settings\Recipe\',
			(*14*)'Cameras\',
			(*15*)'Printers\',	(*16*)'Printers\Templates'];
			
cMETS_AUX_FOLDERS					: ARRAY[1..cSYSTEM_FOLDER_LIMIT] OF T_FolderName :=[
			(*01*)'CAC\',		(*02*)'CAC\Archive\',		(*03*)'CAC\Error\',		(*04*)'CAC\Restored\',
			(*05*)'OAC\',		(*06*)'OAC\Error\',			(*07*)'OAC\Empty\',
			(*08*)'OCV\',		(*09*)'OCV\Error\',			(*10*)'OCV\Empty\',
			(*11*)'SystemLog\',
			(*12*)'ArchiveDB\',
			(*13*)'BridgeApp\Bridge_Core\',
			(*14*)'LoggerApp\Service\',
			(*15*)'WebHMI\',
			(*16*)'DeleteArchiveTool\'];

*************************************************************************************)
(********************************************************************************
Delete Items
	DeleteItem <path> <filesToKeep> [createLog] [deleteDirs] [dirsToKeep]
	path: Directory path
	filesToKeep: Number OF files TO RETAIN
	createLog: (Optional) Boolean to enable logging
	deleteDirs: (Optional) Boolean to include directories
	dirsToKeep: (Optional) Number of directories to retain

Delete by Time
	DeleteTime <path> <fileAge> [createLog] [deleteDirs] [ageUnit]
	path: Directory path
	fileAge: Maximum age of files to retain
	createLog: (Optional) Boolean to enable logging
	deleteDirs: (Optional) Boolean to include inside directories for file search
	ageUnit: (Optional) Time unit for age values (Day/Hour/Minute), defaults to Day

Archive
	Archive <chmArchiveFolder> <lastArchiveDateName> [createLog]
	chmArchiveFolder: Archive folder path
	lastArchiveDateName: Last archive date identifier
	createLog: (Optional) Boolean TO enable logging
*************************************************************************************)
END_VAR]]></Declaration>

bValidationOK	:= bEntireCodeLengthOK;

FOR nItemIndex :=1 TO cMAX_VALIDATION_ITEMS DO
	CASE stCodeInfo.stGS1_Field[nItemIndex].eGS1_AIType OF
	GS1_01:
		bValidationOK := bValidationOK AND bGS1_01_OK;
	GS1_10:

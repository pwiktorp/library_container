	bValidateForRefeedDone: BOOL;
	bValidateForRefeedOK: BOOL;

	rtrigValidateOCVForDataExistValid			: R_TRIG;
	rtrigValidateOCVForDataExistInvalid			: R_TRIG;
	rtrigValidateOCVForDataNotExist			: R_TRIG;
	tofValidateOCVForDataExisValid			: TOF;
	tofValidateOCVForDataExisInvalid			: TOF;

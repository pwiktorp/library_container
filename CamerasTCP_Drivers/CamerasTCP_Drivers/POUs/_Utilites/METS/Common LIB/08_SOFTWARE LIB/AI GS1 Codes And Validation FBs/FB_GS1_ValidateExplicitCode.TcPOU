(*********************** ********************************************)
(*********************** NON_GS1_08**************************************)
bNON_GS1_08_OK := FALSE;
sNON_GS1_08 := F_GS1_GetItem(sFullCode, NON_GS1_08, stCodeInfo);

FOR nItemIndex :=1 TO cMAX_VALIDATION_ITEMS DO
	IF stCodeInfo.stGS1_Field[nItemIndex].eGS1_AIType =  NON_GS1_08 THEN
		stItem := stCodeInfo.stGS1_Field[nItemIndex];
		IF stItem.bValidate THEN
			IF (LEN(sNON_GS1_08) = stItem.nCodeLength OR stItem.nCodeLength = 0) AND  ( sNON_GS1_08 =  stGS1_AI_Definition.stNON_GS1_08.sDataField OR stGS1_AI_Definition.stNON_GS1_08.sDataField = '') THEN
				bNON_GS1_08_OK := TRUE;
			END_IF
		ELSE
			bNON_GS1_08_OK := TRUE;
		END_IF
		EXIT;
	END_IF
END_FOR


    <Declaration><![CDATA[PROGRAM F12_PackerQueuesCtrl
VAR

	rtrigScanBarcode				: R_TRIG;
	fbScannerCtrl					: FB_SCANNER_CameraSelect;
	fbImageBuffer					: FB_CASE_LastRowPoisitionBuffer_v2;
	fbCaseContentEvaluation			: FB_SCANNER_Evaluation;

	bShiftBufferDone						: BOOL;

	ctuAuxRowCounter				: CTU;
	nAuxRowIndex						: INT;
	rtrigAuxRowComplete				: R_TRIG;	(*option*)

	fbCaseInspectionSeq			: FB_SYSTEM_SeqControl;
	nSequenceStep				: INT;
	b00_Idle						: BOOL;
	b01_ScanBarcode				: BOOL;
	b06_MoveOutersToCaseData		: BOOL;
	b20_Done						: BOOL;

	bBusy						: BOOL;
	fbScanTimeout					: TON;

	fbFailedReadCounter			: CTU;
	fbMoveOuterToCaseDataPosition	: FB_CASE_MoveOutersRowToPacker;
	rtrigCaseContentValidation				: R_TRIG;

	fbValidationIndexOK						: FB_CTU32;
	fbValidationIndexUnder					: FB_CTU32;
	fbValidationIndexOver					: FB_CTU32;
	fbValidationNotFound					: FB_CTU32;

	tofCaseContentCameraOFFDelay 	: TOF;
	bTest	: BOOL;


	fbDebugCNT				: FB_DEBUG_CounterArray;
	aCNTDebug				: ARRAY [1..10] OF UDINT;
	bResetCNT					: BOOL;

END_VAR
(*
VAR CONSTANT
	sOptions						: ST_SCANNER_Options := (eScannerType := E_MV_420_FULL, nImageBuffer := 1, nExpectedResp := 1);
END_VAR*)

(*
Modification history:
Date		|	Author 		|	Remark
----------------------------------------------------------------------------------------------------
02.09.20	|	PP			|	Start Remarking.
*)
]]></Declaration>

<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_MC2_DigLockCtrl" Id="{f4a659a3-8614-4fa2-af87-9a7122a8e94b}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_MC2_DigLockCtrl
VAR_INPUT
	bLockAxis			: BOOL;				(* set TRUE to lock axis, set FALSE to unlock axis *)
	fGearRatio			: LREAL;			(* gear ratio, can be changed on every PLC cycle *)
	sRamps				: ST_AxisCtrlRamps;	(* axis ramp structure *)
END_VAR
VAR_IN_OUT
	sAxisMaster			: AXIS_REF;			(* NC axis structure *)
	sAxisSlave			: AXIS_REF;			(* NC axis structure *)
END_VAR
VAR_OUTPUT
	bAxisLocked			: BOOL;				(* TRUE = cam locked *)
	bAxisError			: BOOL;				(* error occurred *)
	nAxisErrorID		: UDINT;			(* error code *)
	bAxisReady			: BOOL;
	bAxisUnlockPulse	: BOOL;				(* one-shot pulse output when slave is unlocked *)
END_VAR
VAR
	fbEnableLock		: RS;
	bEnableLock			: BOOL;
	fbGearIn			: MC_GearInDyn;
	fbGearOut			: MC_GearOut;
	bAxisInGear			: BOOL;
	bAxisActive			: BOOL;
	fbUnlockEvent		: F_TRIG;
	fbUnlockPulse		: TP;
END_VAR
(*
-------------------------------------------------------------------------------------------------
Date		Version	Author	Comments
-------------------------------------------------------------------------------------------------
30/01/2015	3.00.00	PB		No change

-------------------------------------------------------------------------------------------------
12/08/2013	1.11.00	PB		Bug fix - ControlLoopClosed for Slave also now cancels lock
05/02/2010	1.00.00	PB		Initial release

-------------------------------------------------------------------------------------------------
*)
]]></Declaration>

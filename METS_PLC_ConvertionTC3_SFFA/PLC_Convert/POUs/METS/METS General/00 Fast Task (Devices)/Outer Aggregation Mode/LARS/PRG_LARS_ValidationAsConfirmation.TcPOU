	bValidationTimeoutReset				: BOOL;
	fbTimeoutCounter						: CTU;
	nCount									: WORD;
	fbPerformance							: FB_Interval;

	bOuterValidationCameraTrigger			: BOOL;
	aOuterValidationCamera				:  ARRAY[1..2] OF FB_SCANNER_CameraSelect;
	stOuterValidationCameraStatus		: ST_SCANNER;
	(*stOuterValidationCameraOptions		: ST_SCANNER_Options := (eScannerType := E_MV_420_FULL, nImageBuffer := 1, nExpectedResp := 2);*)
	aOuterValidationEvaluation			: ARRAY[1..2] OF FB_SCANNER_Evaluation;

	fbValidationCameraOut				: FB_OUTER_ValidationCameraOut;
	fbCheckForDuplicateOuterValidation	: FB_OUTER_CheckDuplicateStatus;

	(*rtrigOuterValidationCameraDone		: R_TRIG;

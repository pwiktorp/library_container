  <POU Name="F15_CaseControlCACData_ORG" Id="{048f1acd-90d8-44f9-bb12-acc3378d5fd2}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM F15_CaseControlCACData_ORG
VAR
	rtrigScanBarcode				: R_TRIG;
	fbScannerCtrl					: FB_SCANNER_CameraSelect;
	bScanCaseLabel				: BOOL;
	fbCaseLableEvaluation			: FB_SCANNER_Evaluation;

	rtrigSetCaseValidationOK			: R_TRIG;
	rtrigSetCaseValidationNOK		: R_TRIG;

	sCaseSerialCode				: T_CASE_Barcode;
	sFirstOuterInCase				: T_OUTER_Barcode;
	sLastOuterInCase				: T_OUTER_Barcode;
	sFirstPackSerialCode			: T_PACK_Barcode;
	sLastPackSerialCode				: T_PACK_Barcode;


	fbSequenceControl				: FB_SYSTEM_SeqControl;
	nSequenceStep				: INT;
	b00_Idle						: BOOL;
	b01_ScanLabel					: BOOL;
	b03_CreateFileName			: BOOL;
	b05_MoveCaseData				: BOOL;
	b08_WriteFSSFile				: BOOL;
	b10_CaseTraceValid			: BOOL;
	b18_CaseValid					: BOOL;
	b19_CaseInvalid				: BOOL;
	b20_Done						: BOOL;

	bDone						: BOOL;
	bBusy						: BOOL;
	tonScanTimeout					: TON;
	tonOverTime				: TON;

	rtrigCACData				: R_TRIG;
	tF15TimeExecution		: TIME;
	bTestSeq						: BOOL;
	sCACFileTemplate				: T_CAC_Filename;

	stValidateCACData				: ST_CAC_Data;
	fbMoveCaseData				: FB_CASE_ValidateAndMoveCACData;

	sPrintCaseContent				: STRING(255);

	fbPopulateCHMData				: FB_CHM_PopulateDataForFSS3;
	fbWriteCHMFile				: FB_CHM_WriteFSS3Files; (*Old system supporting FSS2 -> FB_CHM_WriteFSSFile;*)

	fbWriteCACToArchive 			: FB_CAC_WriteToArchive_v2;
	fbWriteCACToArchiveDB			: FB_CAC_WriteHierachyToDB;
	fbCaseStatusPulse				: TON;
	bCACValid					: BOOL;
	bCHMValid					: BOOL;


	fbMoveVerifiedCAC				: FB_CASE_MoveVerifiedCAC;
	fbMoveFailedCAC				: FB_CASE_MoveFailedCAC;

	fbCaseEfficiency				: FB_KPI_GenericEfficiency;
	fbCaseInspectionEfficiency		: FB_KPI_CaseEfficiency;
	(*fbCaseInspectionEfficiency		: FB_KPI_PACAN_CaseEfficiency;*)
	fbRejectCount					: CTU;
	nRejectActualCount				: INT;

	fbCaseValidationScanned			: FB_CTU32;
	fbCaseValidationCorrect			: FB_CTU32;
	fbCaseValidationNoCaseLabel		: FB_CTU32;
	fbCaseValidationCasePackerReject	: FB_CTU32;

	aLastCaseBarcodes				: ARRAY[1..cMAX_LAST_CASE_BARCODES] OF T_CASE_Barcode;
	fbAddVerifiedCaseBarcode		: FB_CASE_AddVerifiedCaseBarcode;

	fbCaseLevelCounter	: FB_KPI_CaseLevelCounter;
	tofCaseValidationCameraOFFDelay 	: TOF;

	fbFileWriteCACError				: FB_LOG_FileWriteError;
	fbFileWriteCHMError			: FB_LOG_FileWriteError;

END_VAR
(*
VAR CONSTANT
	sOptions						: ST_SCANNER_Options := (eScannerType := E_MV_440SR_FULL, nImageBuffer := 1, nExpectedResp := 1);
END_VAR*)]]></Declaration>

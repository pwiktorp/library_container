    <Action Name="ShiftActivationBit" Id="{9e0a5311-b3b3-4fb0-a68b-309677878966}">
      <Implementation>
        <ST><![CDATA[IF fbMaintainDeleteTime.bOutput	THEN
	IF nActivateBitWord = 0 THEN
		nActivateBitWord := 1;
	ELSE
		nActivateBitWord :=SHL(nActivateBitWord,1);
	END_IF
END_IF]]></ST>
      </Implementation>
    </Action>

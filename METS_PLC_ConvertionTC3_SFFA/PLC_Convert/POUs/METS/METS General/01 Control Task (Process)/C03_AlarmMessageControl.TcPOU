<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="C03_AlarmMessageControl" Id="{08bc1f85-53a7-41a4-86b5-45f09ed07d2c}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM C03_AlarmMessageControl
VAR
	bAlarmGroup0Reset 		:BOOL;
	bAlarmGroup1Reset 		:BOOL;
	bAlarmGroup2Reset 		:BOOL;
	bAlarmGroup3Reset 		:BOOL;
	bAlarmGroup4Reset 		:BOOL;
	bAlarmGroup5Reset 		:BOOL;
	bAlarmGroup6Reset 		:BOOL;
	bAlarmGroup7Reset 		:BOOL;

	fbMsg_GroupPriority0	:FB_ALARM_GroupManagment;
	fbMsg_GroupPriority1	:FB_ALARM_GroupManagment;
	fbMsg_GroupPriority2	:FB_ALARM_GroupManagment;
	fbMsg_GroupPriority3	:FB_ALARM_GroupManagment;
	fbMsg_GroupPriority4	:FB_ALARM_GroupManagment;
	fbMsg_GroupPriority5	:FB_ALARM_GroupManagment;
	fbMsg_GroupPriority6	:FB_ALARM_GroupManagment;
	fbMsg_GroupPriority7	:FB_ALARM_GroupManagment;

	fbLogTable							: FB_ALARM_LogTable;
	//fbOutputDB						: FB_ALARM_OutputDB;

	aAlarmPulse						: ARRAY[0..255] OF TP;
	aTorqueStartDelayTimer			: ARRAY[1..cMAX_PROFINET_DRIVES] OF TON;

	nAlarmIndex						: INT;
	aMsgGroupStartIndex				: ARRAY[0..10] OF INT;

	bGeneralSystemAlarmActive		: BOOL;		(*Message type 0*)
	bEUCASubsytemAlarmActive		: BOOL;		(*Message type 1*)
	bTPDSubsytemAlarmActive			: BOOL;		(*Message type 2*)
	bExternalAlarmActive			: BOOL;		(*Message type 3*)

	bSpare04AlarmActive				: BOOL;		(*Message type 4*)
	bSpare05AlarmActive				: BOOL;		(*Message type 5*)
	bSpare06AlarmActive				: BOOL;		(*Message type 6*)
	bSpare07AlarmActive				: BOOL;		(*Message type 7*)

	bGeneralSystemWarningActive		: BOOL;		(*Message type 8*)
	bEUCASubsytemWarningActive		: BOOL;		(*Message type 9*)
	bTPDSubsytemWarningActive		: BOOL;		(*Message type 10*)
	bExternalWarningActive			: BOOL;		(*Message type 11*)

	bSpare12WarningActive			: BOOL;		(*Message type 12*)
	bSpare13WarningActive			: BOOL;		(*Message type 13*)
	bSpare14WarningActive			: BOOL;		(*Message type 14*)
	bSpare15WarningActive			: BOOL;		(*Message type 15*)

END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[(****************************************************************************************)
(*
bAlarmTrigger - set true to activate message
nCategoryNo - message category number (for future purpose)
nMessageTypeNo - message type number determine active message type flag
sTextMessage - message description shown in HMI
tAlarmTimout - message became active after time delay
bAlarmDefinitionEnable - enable message block executing
bInhibitReset - set acknowledge to reset/confirm active message 
*)
(****************************************************************************************)

MsgReset();
nAlarmIndex := 0;

(****************************************************************************************)

aMsgGroupStartIndex[0] := nAlarmIndex;
Msg_000_033_General();

aMsgGroupStartIndex[1] := nAlarmIndex;
Msg_034_074_Cameras();

aMsgGroupStartIndex[2] := nAlarmIndex;
Msg_075_126_Process();

aMsgGroupStartIndex[3] := nAlarmIndex;
Msg_127_150_Sensors();

aMsgGroupStartIndex[4] := nAlarmIndex;
Msg_151_179_Doors();

aMsgGroupStartIndex[5] := nAlarmIndex;
Msg_180_200_Motors();

aMsgGroupStartIndex[6] := nAlarmIndex;
Msg_201_208_Interface();

aMsgGroupStartIndex[7] := nAlarmIndex;
Msg_209_237_Labellers();

aMsgGroupStartIndex[8] := nAlarmIndex;
Msg_238_243_Spare();

aMsgGroupStartIndex[9] := nAlarmIndex;
Msg_244_253_DB();

aMsgGroupStartIndex[10] := nAlarmIndex;
Msg_254_255_Reserved();

(****************************************************************************************)

fbMsg_GroupPriority0	(

	stAlarms 				:= gMessage.aAlarms[0],
	stAlarmsSettings		:= gMessage.aAlarmsSettings[0]

					);
(****************************************************************************************)

fbMsg_GroupPriority1	(

	stAlarms 				:= gMessage.aAlarms[1],
	stAlarmsSettings		:= gMessage.aAlarmsSettings[1],

					);
(****************************************************************************************)

fbMsg_GroupPriority2	(

	stAlarms 				:= gMessage.aAlarms[2],
	stAlarmsSettings		:= gMessage.aAlarmsSettings[2]

					);
(****************************************************************************************)

fbMsg_GroupPriority3	(

	stAlarms 				:= gMessage.aAlarms[3],
	stAlarmsSettings		:= gMessage.aAlarmsSettings[3],

					);
(****************************************************************************************)

fbMsg_GroupPriority4		(

	stAlarms 				:= gMessage.aAlarms[4],
	stAlarmsSettings		:= gMessage.aAlarmsSettings[4]

					);
(****************************************************************************************)

fbMsg_GroupPriority5	(

	stAlarms 				:= gMessage.aAlarms[5],
	stAlarmsSettings		:= gMessage.aAlarmsSettings[5]

					);
(****************************************************************************************)

fbMsg_GroupPriority6	(

	stAlarms 				:= gMessage.aAlarms[6],
	stAlarmsSettings		:= gMessage.aAlarmsSettings[6]

					);
(****************************************************************************************)

fbMsg_GroupPriority7	(

	stAlarms 				:= gMessage.aAlarms[7],
	stAlarmsSettings		:= gMessage.aAlarmsSettings[7]

					);
(**************************************************************************************************)
(**************************** **********Alarms Logger***********************************************)
(**************************************************************************************************)

fbLogTable(
			bResetActive		:= gDevice.stMetsStatus.bShortReset,
			stAlarmTable		:= gMessage.stAlarmTable,
			aAlarms 			:= gMessage.aAlarms,
			aAlarmsSettings		:= gMessage.aAlarmsSettings,
			stCTDateTime		:= gDevice.stMetsStatus.stCTDateTime
		);
		
(*fbOutputDB(
	bSystemTimeValid		:= gDevice.stMetsStatus.bSystemTimeValid,
	stCTDateTime			:= gDevice.stMetsStatus.stCTDateTime,
	nAppOnlineChangeCnt 	:= gDevice.stPLCAppSys.OnlineChangeCnt,
	stAlarmTable			:= gMessage.stAlarmTable,
	stMachineConfig			:= gDevice.stMachineConfig
	);
*)
(**************************************************************************************************)
(**************************** **********Fault Monitor***********************************************)
(**************************************************************************************************)

IF 	gMessage.aAlarms[0].nMessageType.0	OR
	gMessage.aAlarms[1].nMessageType.0	OR
	gMessage.aAlarms[2].nMessageType.0	OR
	gMessage.aAlarms[3].nMessageType.0	OR
	gMessage.aAlarms[4].nMessageType.0	OR
	gMessage.aAlarms[5].nMessageType.0	OR
	gMessage.aAlarms[6].nMessageType.0	OR
	gMessage.aAlarms[7].nMessageType.0	THEN

		gMessage.stAlarmStatus.bGeneralSystemAlarmActive	:=	TRUE;
ELSE
		gMessage.stAlarmStatus.bGeneralSystemAlarmActive	:= 	FALSE;
END_IF

IF 	gMessage.aAlarms[0].nMessageType.1	OR
	gMessage.aAlarms[1].nMessageType.1	OR
	gMessage.aAlarms[2].nMessageType.1	OR
	gMessage.aAlarms[3].nMessageType.1	OR
	gMessage.aAlarms[4].nMessageType.1	OR
	gMessage.aAlarms[5].nMessageType.1	OR
	gMessage.aAlarms[6].nMessageType.1	OR
	gMessage.aAlarms[7].nMessageType.1	THEN

		gMessage.stAlarmStatus.bEUCASubsytemAlarmActive	:=	TRUE;
ELSE
		gMessage.stAlarmStatus.bEUCASubsytemAlarmActive	:= 	FALSE;
END_IF

IF 	gMessage.aAlarms[0].nMessageType.2	OR
	gMessage.aAlarms[1].nMessageType.2	OR
	gMessage.aAlarms[2].nMessageType.2	OR
	gMessage.aAlarms[3].nMessageType.2	OR
	gMessage.aAlarms[4].nMessageType.2	OR
	gMessage.aAlarms[5].nMessageType.2	OR
	gMessage.aAlarms[6].nMessageType.2	OR
	gMessage.aAlarms[7].nMessageType.2	THEN

		gMessage.stAlarmStatus.bTPDSubsytemAlarmActive	:=	TRUE;
ELSE
		gMessage.stAlarmStatus.bTPDSubsytemAlarmActive	:= 	FALSE;
END_IF

IF 	gMessage.aAlarms[0].nMessageType.3	OR
	gMessage.aAlarms[1].nMessageType.3	OR
	gMessage.aAlarms[2].nMessageType.3	OR
	gMessage.aAlarms[3].nMessageType.3	OR
	gMessage.aAlarms[4].nMessageType.3	OR
	gMessage.aAlarms[5].nMessageType.3	OR
	gMessage.aAlarms[6].nMessageType.3	OR
	gMessage.aAlarms[7].nMessageType.3	THEN

		gMessage.stAlarmStatus.bExternalAlarmActive	:=	TRUE;
ELSE
		gMessage.stAlarmStatus.bExternalAlarmActive	:= 	FALSE;
END_IF

IF 	gMessage.aAlarms[0].nMessageType.4	OR
	gMessage.aAlarms[1].nMessageType.4	OR
	gMessage.aAlarms[2].nMessageType.4	OR
	gMessage.aAlarms[3].nMessageType.4	OR
	gMessage.aAlarms[4].nMessageType.4	OR
	gMessage.aAlarms[5].nMessageType.4	OR
	gMessage.aAlarms[6].nMessageType.4	OR
	gMessage.aAlarms[7].nMessageType.4	THEN

		gMessage.stAlarmStatus.bSpare04AlarmActive	:=	TRUE;
ELSE
		gMessage.stAlarmStatus.bSpare04AlarmActive	:= 	FALSE;
END_IF

IF 	gMessage.aAlarms[0].nMessageType.5	OR
	gMessage.aAlarms[1].nMessageType.5	OR
	gMessage.aAlarms[2].nMessageType.5	OR
	gMessage.aAlarms[3].nMessageType.5	OR
	gMessage.aAlarms[4].nMessageType.5	OR
	gMessage.aAlarms[5].nMessageType.5	OR
	gMessage.aAlarms[6].nMessageType.5	OR
	gMessage.aAlarms[7].nMessageType.5	THEN

		gMessage.stAlarmStatus.bSpare05AlarmActive	:=	TRUE;
ELSE
		gMessage.stAlarmStatus.bSpare05AlarmActive	:= 	FALSE;
END_IF

IF 	gMessage.aAlarms[0].nMessageType.6	OR
	gMessage.aAlarms[1].nMessageType.6	OR
	gMessage.aAlarms[2].nMessageType.6	OR
	gMessage.aAlarms[3].nMessageType.6	OR
	gMessage.aAlarms[4].nMessageType.6	OR
	gMessage.aAlarms[5].nMessageType.6	OR
	gMessage.aAlarms[6].nMessageType.6	OR
	gMessage.aAlarms[7].nMessageType.6	THEN

		gMessage.stAlarmStatus.bSpare06AlarmActive	:=	TRUE;
ELSE
		gMessage.stAlarmStatus.bSpare06AlarmActive	:= 	FALSE;
END_IF

IF 	gMessage.aAlarms[0].nMessageType.7	OR
	gMessage.aAlarms[1].nMessageType.7	OR
	gMessage.aAlarms[2].nMessageType.7	OR
	gMessage.aAlarms[3].nMessageType.7	OR
	gMessage.aAlarms[4].nMessageType.7	OR
	gMessage.aAlarms[5].nMessageType.7	OR
	gMessage.aAlarms[6].nMessageType.7	OR
	gMessage.aAlarms[7].nMessageType.7	THEN

		gMessage.stAlarmStatus.bSpare07AlarmActive	:=	TRUE;
ELSE
		gMessage.stAlarmStatus.bSpare07AlarmActive	:= 	FALSE;
END_IF


IF 	gMessage.aAlarms[0].nMessageType.8	OR
	gMessage.aAlarms[1].nMessageType.8	OR
	gMessage.aAlarms[2].nMessageType.8	OR
	gMessage.aAlarms[3].nMessageType.8	OR
	gMessage.aAlarms[4].nMessageType.8	OR
	gMessage.aAlarms[5].nMessageType.8	OR
	gMessage.aAlarms[6].nMessageType.8	OR
	gMessage.aAlarms[7].nMessageType.8	THEN

		gMessage.stAlarmStatus.bGeneralSystemWarningActive	:=	TRUE;
ELSE
		gMessage.stAlarmStatus.bGeneralSystemWarningActive	:= 	FALSE;
END_IF

IF 	gMessage.aAlarms[0].nMessageType.9	OR
	gMessage.aAlarms[1].nMessageType.9	OR
	gMessage.aAlarms[2].nMessageType.9	OR
	gMessage.aAlarms[3].nMessageType.9	OR
	gMessage.aAlarms[4].nMessageType.9	OR
	gMessage.aAlarms[5].nMessageType.9	OR
	gMessage.aAlarms[6].nMessageType.9	OR
	gMessage.aAlarms[7].nMessageType.9	THEN

		gMessage.stAlarmStatus.bEUCASubsytemWarningActive	:=	TRUE;
ELSE
		gMessage.stAlarmStatus.bEUCASubsytemWarningActive	:= 	FALSE;
END_IF

IF 	gMessage.aAlarms[0].nMessageType.10	OR
	gMessage.aAlarms[1].nMessageType.10	OR
	gMessage.aAlarms[2].nMessageType.10	OR
	gMessage.aAlarms[3].nMessageType.10	OR
	gMessage.aAlarms[4].nMessageType.10	OR
	gMessage.aAlarms[5].nMessageType.10	OR
	gMessage.aAlarms[6].nMessageType.10	OR
	gMessage.aAlarms[7].nMessageType.10	THEN

		gMessage.stAlarmStatus.bTPDSubsytemWarningActive	:=	TRUE;
ELSE
		gMessage.stAlarmStatus.bTPDSubsytemWarningActive	:= 	FALSE;
END_IF

IF 	gMessage.aAlarms[0].nMessageType.11	OR
	gMessage.aAlarms[1].nMessageType.11	OR
	gMessage.aAlarms[2].nMessageType.11	OR
	gMessage.aAlarms[3].nMessageType.11	OR
	gMessage.aAlarms[4].nMessageType.11	OR
	gMessage.aAlarms[5].nMessageType.11	OR
	gMessage.aAlarms[6].nMessageType.11	OR
	gMessage.aAlarms[7].nMessageType.11	THEN

		gMessage.stAlarmStatus.bExternalWarningActive	:=	TRUE;
ELSE
		gMessage.stAlarmStatus.bExternalWarningActive	:= 	FALSE;
END_IF

IF 	gMessage.aAlarms[0].nMessageType.12	OR
	gMessage.aAlarms[1].nMessageType.12	OR
	gMessage.aAlarms[2].nMessageType.12	OR
	gMessage.aAlarms[3].nMessageType.12	OR
	gMessage.aAlarms[4].nMessageType.12	OR
	gMessage.aAlarms[5].nMessageType.12	OR
	gMessage.aAlarms[6].nMessageType.12	OR
	gMessage.aAlarms[7].nMessageType.12	THEN

		gMessage.stAlarmStatus.bSpare12WarningActive	:=	TRUE;
ELSE
		gMessage.stAlarmStatus.bSpare12WarningActive	:= 	FALSE;
END_IF

IF 	gMessage.aAlarms[0].nMessageType.13	OR
	gMessage.aAlarms[1].nMessageType.13	OR
	gMessage.aAlarms[2].nMessageType.13	OR
	gMessage.aAlarms[3].nMessageType.13	OR
	gMessage.aAlarms[4].nMessageType.13	OR
	gMessage.aAlarms[5].nMessageType.13	OR
	gMessage.aAlarms[6].nMessageType.13	OR
	gMessage.aAlarms[7].nMessageType.13	THEN

		gMessage.stAlarmStatus.bSpare13WarningActive	:=	TRUE;
ELSE
		gMessage.stAlarmStatus.bSpare13WarningActive	:= 	FALSE;
END_IF

IF 	gMessage.aAlarms[0].nMessageType.14	OR
	gMessage.aAlarms[1].nMessageType.14	OR
	gMessage.aAlarms[2].nMessageType.14	OR
	gMessage.aAlarms[3].nMessageType.14	OR
	gMessage.aAlarms[4].nMessageType.14	OR
	gMessage.aAlarms[5].nMessageType.14	OR
	gMessage.aAlarms[6].nMessageType.14	OR
	gMessage.aAlarms[7].nMessageType.14	THEN

		gMessage.stAlarmStatus.bSpare14WarningActive	:=	TRUE;
ELSE
		gMessage.stAlarmStatus.bSpare14WarningActive	:= 	FALSE;
END_IF

IF 	gMessage.aAlarms[0].nMessageType.15	OR
	gMessage.aAlarms[1].nMessageType.15	OR
	gMessage.aAlarms[2].nMessageType.15	OR
	gMessage.aAlarms[3].nMessageType.15	OR
	gMessage.aAlarms[4].nMessageType.15	OR
	gMessage.aAlarms[5].nMessageType.15	OR
	gMessage.aAlarms[6].nMessageType.15	OR
	gMessage.aAlarms[7].nMessageType.15	THEN

		gMessage.stAlarmStatus.bSpare15WarningActive	:=	TRUE;
ELSE
		gMessage.stAlarmStatus.bSpare15WarningActive	:= 	FALSE;
END_IF

(**************************************************************************************************)
(**********************************Group Fault Monitor**********************************************)
(**************************************************************************************************)

(*Message type from 0 to 3 are set up as alarms - if modyfie it is neccesary change alarm definition F_ALARM_SetDefinition for AutoReset flag*)

IF 	gMessage.stAlarmStatus.bGeneralSystemAlarmActive 		OR
	gMessage.stAlarmStatus.bEUCASubsytemAlarmActive 		OR
	gMessage.stAlarmStatus.bTPDSubsytemAlarmActive			OR
	gMessage.stAlarmStatus.bExternalAlarmActive				OR
	gMessage.stAlarmStatus.bSpare04AlarmActive 				OR
	gMessage.stAlarmStatus.bSpare05AlarmActive 				OR
	gMessage.stAlarmStatus.bSpare06AlarmActive				OR
	gMessage.stAlarmStatus.bSpare07AlarmActive				THEN

		gMessage.stAlarmStatus.bNoActiveAlarms	:=	FALSE;
ELSE
		gMessage.stAlarmStatus.bNoActiveAlarms	:=	TRUE;
END_IF

(*Message type from 4 to 7 are set up as warnings - if modyfie it is neccesary change alarm definition F_ALARM_SetDefinition for AutoReset flag*)

IF 	gMessage.stAlarmStatus.bGeneralSystemWarningActive 		OR
	gMessage.stAlarmStatus.bEUCASubsytemWarningActive 	OR
	gMessage.stAlarmStatus.bTPDSubsytemWarningActive		OR
	gMessage.stAlarmStatus.bExternalWarningActive			OR
	gMessage.stAlarmStatus.bSpare12WarningActive 			OR
	gMessage.stAlarmStatus.bSpare13WarningActive 			OR
	gMessage.stAlarmStatus.bSpare14WarningActive			OR
	gMessage.stAlarmStatus.bSpare15WarningActive			THEN

		gMessage.stAlarmStatus.bNoActiveWarrnings	:=	FALSE;
ELSE
		gMessage.stAlarmStatus.bNoActiveWarrnings	:=	TRUE;
END_IF]]></ST>
    </Implementation>
